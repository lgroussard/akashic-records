<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Music library: reads the audio files of the chosen folder (Music/Akashic by default). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Serveur → « Ce téléphone »: the storage measured folder by folder (sizes and names only, read-only). Given by
         the user in the settings (« Accès à tous les fichiers »), asked only from that screen. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Background playback (media notification + lock screen controls). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Suggestions (iTunes / MusicBrainz), 30 s previews and yt-dlp downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- « Enchaîner des suggestions : en Wi-Fi seulement »: is the current network metered? -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Calendar: morning summary, event reminders, birthday pop-ups. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The reminder alarm is lost when the phone restarts: armed again at boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The next-ticket widget appears right an hour before a departure (an inexact alarm can come much later). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Downloads written to Music/ on Android 9 and below (MediaStore is used from Android 10). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- usesCleartextTraffic: the sync hub is a box on the home network, reached over plain http. -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share → Akashic: an image or a link from Pinterest, Instagram, a browser… goes to the Références. -->
            <intent-filter android:label="Références Akashic">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Références Akashic">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Share → « Billet Akashic »: train tickets, boarding passes… (PDF or picture, several at once), attached to
             a calendar event or a day. Same activity; MainActivity tells it apart by this alias's name. -->
        <activity-alias
            android:name=".ShareTicket"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="Billet Akashic"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".music.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- The headset's play button after the service is gone: restarts it, which resumes the saved queue
             (PlaybackService.onPlaybackResumption). Hands over to Media3's MediaButtonReceiver. -->
        <receiver
            android:name=".music.ResumeButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- Calendar reminders: the alarm of the next one, and its re-arming after a restart. -->
        <receiver
            android:name=".calendar.ReminderAlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Next-ticket widget: the moment a ticket comes into or out of view. -->
        <receiver
            android:name=".widgets.TicketWidgetAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".widgets.TicketWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Billet">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ticket" />
        </receiver>
        <!-- Home-screen widgets: a launcher page of them stands in for "swipe right to Akashic". -->
        <receiver
            android:name=".widgets.AgendaWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda" />
        </receiver>
        <receiver
            android:name=".widgets.JournalWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Journal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_journal" />
        </receiver>
        <receiver
            android:name=".widgets.MusicWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Musique">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music" />
        </receiver>
        <receiver
            android:name=".widgets.PoemWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Poésie">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_poem" />
        </receiver>
        <receiver
            android:name=".widgets.RecipeWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Recettes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recipe" />
        </receiver>
        <receiver
            android:name=".widgets.WatchlistWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Collections">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_watch" />
        </receiver>
        <receiver
            android:name=".widgets.OrganisationWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Organisation">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_organisation" />
        </receiver>
        <receiver
            android:name=".widgets.PhotoWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Archives">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_photo" />
        </receiver>
        <receiver
            android:name=".widgets.CrosswordWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Mots croisés">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_crossword" />
        </receiver>
    </application>
</manifest>
