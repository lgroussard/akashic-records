<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Music library: reads the audio files of the chosen folder (Music/Akashic by default). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Background playback (media notification + lock screen controls). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Suggestions (iTunes / MusicBrainz), 30 s previews and yt-dlp downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Calendar: morning summary, event reminders, birthday pop-ups. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Downloads written to Music/ on Android 9 and below (MediaStore is used from Android 10). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <service
            android:name=".music.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Home-screen widgets: a launcher page of them stands in for "swipe right to Akashic". -->
        <receiver
            android:name=".widgets.AgendaWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Agenda">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda" />
        </receiver>
        <receiver
            android:name=".widgets.JournalWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Journal">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_journal" />
        </receiver>
        <receiver
            android:name=".widgets.MusicWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Musique">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_music" />
        </receiver>
        <receiver
            android:name=".widgets.PoemWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Poésie">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_poem" />
        </receiver>
        <receiver
            android:name=".widgets.RecipeWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Recettes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recipe" />
        </receiver>
        <receiver
            android:name=".widgets.WatchlistWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Collections">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_watch" />
        </receiver>
        <receiver
            android:name=".widgets.OrganisationWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Organisation">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_organisation" />
        </receiver>
        <receiver
            android:name=".widgets.PhotoWidgetReceiver"
            android:exported="true"
            android:label="Akashic · Archives">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_photo" />
        </receiver>
    </application>
</manifest>
