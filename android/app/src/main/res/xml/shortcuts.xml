<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher long-press shortcuts: each opens a section (and sub-tab) through MainActivity extras. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="poetry"
        android:enabled="true"
        android:icon="@drawable/pin_poetry"
        android:shortcutShortLabel="@string/sc_poetry_short"
        android:shortcutLongLabel="@string/sc_poetry_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.akashicrecords"
            android:targetClass="com.akashicrecords.MainActivity">
            <extra android:name="akashic.section" android:value="Journaux" />
            <extra android:name="akashic.tab" android:value="Poetry" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="calendar"
        android:enabled="true"
        android:icon="@drawable/pin_calendar"
        android:shortcutShortLabel="@string/sc_calendar_short"
        android:shortcutLongLabel="@string/sc_calendar_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.akashicrecords"
            android:targetClass="com.akashicrecords.MainActivity">
            <extra android:name="akashic.section" android:value="Calendrier" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="music"
        android:enabled="true"
        android:icon="@drawable/pin_music"
        android:shortcutShortLabel="@string/sc_music_short"
        android:shortcutLongLabel="@string/sc_music_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.akashicrecords"
            android:targetClass="com.akashicrecords.MainActivity">
            <extra android:name="akashic.section" android:value="Musique" />
            <extra android:name="akashic.tab" android:value="Library" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="downloads"
        android:enabled="true"
        android:icon="@drawable/pin_download"
        android:shortcutShortLabel="@string/sc_download_short"
        android:shortcutLongLabel="@string/sc_download_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.akashicrecords"
            android:targetClass="com.akashicrecords.MainActivity">
            <extra android:name="akashic.section" android:value="Musique" />
            <extra android:name="akashic.tab" android:value="Downloads" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="reading"
        android:enabled="true"
        android:icon="@drawable/pin_reading"
        android:shortcutShortLabel="@string/sc_reading_short"
        android:shortcutLongLabel="@string/sc_reading_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.akashicrecords"
            android:targetClass="com.akashicrecords.MainActivity">
            <extra android:name="akashic.section" android:value="Lecture" />
        </intent>
    </shortcut>
</shortcuts>
