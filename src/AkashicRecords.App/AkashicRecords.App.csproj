<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AkashicRecords.Domain\AkashicRecords.Domain.csproj" />
    <ProjectReference Include="..\AkashicRecords.Infrastructure\AkashicRecords.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Colour emoji in WPF text (WPF alone draws them monochrome, or as boxes for newer ones). -->
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="setup-tools.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
