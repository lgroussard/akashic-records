<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AkashicRecords.Domain\AkashicRecords.Domain.csproj" />
    <ProjectReference Include="..\AkashicRecords.Infrastructure\AkashicRecords.Infrastructure.csproj" />
    <ProjectReference Include="..\AkashicRecords.Sync\AkashicRecords.Sync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Colour emoji in WPF text (WPF alone draws them monochrome, or as boxes for newer ones). -->
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <!-- Image upscaling for the hub's shared computing: the model engine on the graphics card (DirectML,
         processor if that fails) and image reading/writing. The upscaler itself is the hub's own file. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AkashicRecords.Hub\OnnxUpscaler.cs" Link="Sync\OnnxUpscaler.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="setup-tools.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
