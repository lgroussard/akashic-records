<Window x:Class="AkashicRecords.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AkashicRecords.App"
        mc:Ignorable="d"
        Title="Akashic Records"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Closing="MainWindow_OnClosing"
        KeyDown="MainWindow_OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Always interactive; the rest of the screen is click-through unless a section is open -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="#EE1A1A2E" BorderBrush="#553B82F6" BorderThickness="0,0,0,1">
            <Grid Margin="16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="AKASHIC RECORDS" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton x:Name="OrganisationNav" Content="Organisation"
                                  Style="{StaticResource NavButtonStyle}"
                                  Click="NavButton_OnClick" Tag="Organisation"/>
                    <ToggleButton x:Name="JournauxNav" Content="Journaux"
                                  Style="{StaticResource NavButtonStyle}"
                                  Click="NavButton_OnClick" Tag="Journaux"/>
                    <ToggleButton x:Name="CollectionsNav" Content="Collections"
                                  Style="{StaticResource NavButtonStyle}"
                                  Click="NavButton_OnClick" Tag="Collections"/>
                    <ToggleButton x:Name="ArchivesNav" Content="Archives"
                                  Style="{StaticResource NavButtonStyle}"
                                  Click="NavButton_OnClick" Tag="Archives"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="SearchBoxContainer" Width="240" Height="30" Margin="0,0,8,0"
                            Background="#2A2A45" CornerRadius="6" VerticalAlignment="Center">
                        <Grid>
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="White"
                                     BorderThickness="0" VerticalContentAlignment="Center"
                                     Padding="8,0" CaretBrush="White"
                                     TextChanged="SearchBox_OnTextChanged"
                                     PreviewKeyDown="SearchBox_OnPreviewKeyDown"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Rechercher…" Foreground="#888888"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Button x:Name="MusicButton" Content="♪ Musique"
                            VerticalAlignment="Center"
                            Style="{StaticResource ChipButtonStyle}"
                            Click="MusicButton_OnClick"/>
                    <Button x:Name="SettingsButton" Content="⚙" Width="36" Height="30"
                            VerticalAlignment="Center"
                            Style="{StaticResource ChipButtonStyle}"
                            Click="SettingsButton_OnClick"/>
                </StackPanel>

                <!-- Anchored to the header (always interactive); renders in its own top-level window so
                     the click-through hit-test on the main window never swallows clicks on results. -->
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBoxContainer}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="4">
                    <Border Width="420" Background="#F21A1A2E" BorderBrush="#553B82F6" BorderThickness="1"
                            CornerRadius="6" Padding="4">
                        <Grid>
                            <TextBlock x:Name="NoResultsText" Text="Aucun résultat" Foreground="#888888"
                                       Margin="10,8" Visibility="Collapsed"/>
                            <ListBox x:Name="SearchResultsList" MaxHeight="420" Background="Transparent"
                                     BorderThickness="0" Foreground="White"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewKeyDown="SearchResultsList_OnPreviewKeyDown"
                                     PreviewMouseLeftButtonUp="SearchResultsList_OnMouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Section}" Foreground="#7FB0FF"
                                                       FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Title}" Foreground="White"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Snippet}" Foreground="#AAAAAA"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Only visible/interactive once a section is selected; otherwise fully transparent and click-through -->
        <Border x:Name="SectionBackdrop" Grid.Row="1" Background="Transparent">
            <ContentControl x:Name="SectionContent" Margin="16"/>
        </Border>
    </Grid>
</Window>


