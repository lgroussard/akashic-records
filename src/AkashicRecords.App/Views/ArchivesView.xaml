<UserControl x:Class="AkashicRecords.App.Views.ArchivesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <!-- Main content: two sub-tabs (Photos / Archive familiale) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title + subtitle -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Archives" FontSize="22" FontWeight="800"
                               Foreground="White" Margin="0,0,0,2"/>
                    <TextBlock Text="Vos photos et souvenirs, retrouvables d'un coup d'œil."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,12"/>
                </StackPanel>
            </Grid>

            <!-- Toolbar: segmented tabs + filter tags + import -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Segmented sub-tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton x:Name="PhotosTab" Content="Photos" Tag="Photos" IsChecked="True"
                                  Style="{StaticResource SubTabStyle}" Click="SubTab_OnClick"/>
                    <ToggleButton x:Name="FamilialeTab" Content="Archive familiale" Tag="Familiale"
                                  Style="{StaticResource SubTabStyle}" Click="SubTab_OnClick"/>
                </StackPanel>

                <!-- Filter tags -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="AllPhotosToggle" Content="Toutes" Tag="All"
                                  Style="{StaticResource TagChipStyle}" Click="FilterToggle_OnClick"/>
                    <ToggleButton x:Name="FavoritesToggle" Content="★ Favoris" Tag="Favorites"
                                  Style="{StaticResource TagChipStyle}" Click="FilterToggle_OnClick"/>
                </StackPanel>

                <!-- Import button -->
                <Button Grid.Column="2" Content="＋ Importer" Click="ImportButton_OnClick"
                        Style="{StaticResource PrimaryPillButtonStyle}"/>
            </Grid>

            <!-- Photos tab -->
            <Grid x:Name="PhotosRoot" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Albums sidebar -->
                <Border Grid.Column="0" Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,1,0"
                        CornerRadius="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <Grid>
                                <TextBox x:Name="SearchInput"
                                        Style="{StaticResource DarkTextBoxStyle}"
                                        Margin="0,0,0,10"
                                        TextChanged="SearchInput_OnTextChanged"/>
                                <TextBlock x:Name="SearchWatermark" Text="Tag, titre…" Foreground="{StaticResource TextFaintBrush}"
                                           Margin="9,7,0,0" IsHitTestVisible="False"/>
                            </Grid>
                            <TextBlock Text="ALBUMS" Style="{StaticResource PanelSectionHeaderStyle}"
                                       Margin="0,0,0,8"/>
                            <StackPanel x:Name="AlbumList"/>
                            <Button x:Name="NewAlbumButton" Content="＋ Nouvel album"
                                    Click="NewAlbumButton_OnClick"
                                    Style="{StaticResource SecondaryPillButtonStyle}"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Photo grid -->
                <Border Grid.Column="1" Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="0">
                    <ScrollViewer x:Name="GridScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ThumbnailPanel" Margin="16"
                                   ItemWidth="150" ItemHeight="150"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Archive familiale tab: deferred placeholder -->
            <Grid x:Name="FamilialeRoot" Grid.Row="2" Visibility="Collapsed">
                <Border Background="{StaticResource Surface1Brush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📖" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="Archive familiale" FontSize="15" FontWeight="600"
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,6"/>
                        <TextBlock Text="Import du blog familial — à concevoir avec le site réel."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Fullscreen viewer overlay -->
        <Grid x:Name="ViewerOverlay" Background="#EE04040A" Visibility="Collapsed" Focusable="True"
              PreviewKeyDown="ViewerOverlay_OnPreviewKeyDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Image + navigation -->
            <Grid Grid.Column="0" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="✕" Click="CloseViewerButton_OnClick"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            FontSize="16" Cursor="Hand"/>
                    <TextBlock x:Name="ViewerCounterText" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </DockPanel>

                <Image x:Name="ViewerImage" Grid.Row="1" Stretch="Uniform"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <Button Content="◀ Précédent" Click="PreviousButton_OnClick" Margin="0,0,8,0"/>
                    <Button x:Name="SlideshowButton" Content="▶ Slideshow" Click="SlideshowButton_OnClick"
                            Margin="0,0,8,0"/>
                    <Button x:Name="ViewerFavoriteButton" Content="☆" Click="ViewerFavoriteButton_OnClick"
                            Margin="0,0,8,0" FontSize="14"/>
                    <Button Content="Suivant ▶" Click="NextButton_OnClick"/>
                </StackPanel>
            </Grid>

            <!-- Metadata panel -->
            <Border Grid.Column="1" Background="#2A2A45" CornerRadius="6" Margin="0,16,16,16" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="TITRE" FontSize="10" Foreground="#888888" Margin="0,0,0,4"/>
                        <TextBox x:Name="ViewerTitleInput" Margin="0,0,0,12"/>

                        <TextBlock Text="DESCRIPTION" FontSize="10" Foreground="#888888" Margin="0,0,0,4"/>
                        <TextBox x:Name="ViewerDescriptionInput" Height="70" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="0,0,0,12"/>

                        <TextBlock Text="DATE" FontSize="10" Foreground="#888888" Margin="0,0,0,4"/>
                        <DatePicker x:Name="ViewerDatePicker" Margin="0,0,0,12"/>

                        <TextBlock Text="TAGS" FontSize="10" Foreground="#888888" Margin="0,0,0,4"/>
                        <TextBox x:Name="ViewerTagsInput" Margin="0,0,0,12"/>

                        <Button Content="Enregistrer" Click="SaveMetadataButton_OnClick"
                                HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <TextBlock Text="ALBUM" FontSize="10" Foreground="#888888" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ViewerAlbumCombo" Margin="0,0,0,20"
                                  SelectionChanged="ViewerAlbumCombo_OnSelectionChanged"/>

                        <Button Content="Supprimer la photo" Click="DeletePhotoButton_OnClick"
                                Foreground="White" Background="#7A2A2A" BorderThickness="0"
                                Padding="10,6" HorizontalAlignment="Left" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>