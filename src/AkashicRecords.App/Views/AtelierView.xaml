<UserControl x:Class="AkashicRecords.App.Views.AtelierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title, mode chooser (Cartes / Chrono), state pill. Same segmented shape as the
             Journaux tab row, so the two sections read as one family. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Atelier" FontSize="20" FontWeight="Bold"
                       FontFamily="Georgia" Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Border DockPanel.Dock="Left" Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ModeCartesTab" Content="Cartes" IsChecked="True"
                                  Style="{StaticResource NavButtonStyle}" Click="ModeTab_OnClick" Tag="Cartes"/>
                    <ToggleButton x:Name="ModeChronoTab" Content="Chrono"
                                  Style="{StaticResource NavButtonStyle}" Click="ModeTab_OnClick" Tag="Chrono"/>
                </StackPanel>
            </Border>
            <Border x:Name="StatePill" DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}"
                    CornerRadius="999" Padding="12,4" VerticalAlignment="Center">
                <TextBlock x:Name="StatePillText" Text="1 / 32 · Structure" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <!-- ══ MODE CARTES: the current drill, its references, the session bar. ══ -->
            <Grid x:Name="CartesRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The exercise itself: kicker, serif title, numbered steps, control chips. -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="ExKicker" Text="EXERCICE 1 · STRUCTURE · 5 MIN" FontSize="11"
                                   FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="ExTitle" Text="" FontFamily="Georgia" FontSize="22"
                                   FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="StepsHost"/>
                        <WrapPanel x:Name="ChipsHost" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Study references: one line per work, thumbnail on the right when Commons answers. -->
                <WrapPanel Grid.Row="1" x:Name="RefsHost" Margin="0,0,0,14"/>

                <!-- Session bar: the linear progression, no history kept. -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="AVANCEMENT DE LA SESSION" Style="{StaticResource PanelSectionHeaderStyle}"
                                   Margin="0,0,0,8"/>
                        <Grid Height="6">
                            <Border Background="{StaticResource Surface3Brush}" CornerRadius="3"/>
                            <Border x:Name="ProgressFill" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentGradientBrush}" Width="0"/>
                        </Grid>
                        <WrapPanel x:Name="ProgressChips" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Paging, in the same spare style as the poem page. -->
                <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="◀ Préc." Click="PrevButton_OnClick"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"/>
                    <Button DockPanel.Dock="Right" Content="Suiv. ▶" Click="NextButton_OnClick"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"/>
                </DockPanel>
            </Grid>

            <!-- ══ MODE CHRONO: one 30-second subject, chips for the sketches, auto-advance. ══ -->
            <Grid x:Name="ChronoRoot" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CHRONO · 30 S PAR CROQUIS" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ChronoTime" Text="30 s" FontFamily="Georgia" FontSize="40"
                                       FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <WrapPanel x:Name="ChronoChips" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                            <TextBlock x:Name="ChronoSubjectText" Text="" Foreground="{StaticResource TextBrush}"
                                       FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="Redémarrer" Style="{StaticResource PrimaryButtonStyle}"
                            Click="ChronoRestart_OnClick" Margin="0,0,8,0"/>
                    <Button x:Name="ChronoPauseButton" Content="⏸" Style="{StaticResource MiniButtonStyle}"
                            Click="ChronoPause_OnClick"/>
                </StackPanel>

                <!-- The drawing surface, on the same sheet: a gridded card under the chrono row. -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Background="{StaticResource CanvasGridBrush}"
                        MinHeight="260">
                    <TextBlock Text="6 croquis sur la même feuille" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" Margin="12" VerticalAlignment="Top"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
