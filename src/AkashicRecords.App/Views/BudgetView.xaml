<UserControl x:Class="AkashicRecords.App.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title + subtitle -->
        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <TextBlock Text="Budget" FontSize="22" FontWeight="800" Foreground="White" Margin="0,0,0,2"/>
            <TextBlock Text="Vos opérations importées, vos catégories, vos enveloppes mensuelles."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Segmented sub-tabs (same idiom as Archives/Journaux) -->
        <Border Grid.Row="1" HorizontalAlignment="Left" Margin="0,0,0,12" Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="OverviewTab" Content="Vue d'ensemble" Tag="Overview" IsChecked="True"
                              Style="{StaticResource SubTabStyle}" Click="SubTab_OnClick"/>
                <ToggleButton x:Name="TransactionsTab" Content="Opérations" Tag="Transactions"
                              Style="{StaticResource SubTabStyle}" Click="SubTab_OnClick"/>
                <ToggleButton x:Name="PlansTab" Content="Plans" Tag="Plans"
                              Style="{StaticResource SubTabStyle}" Click="SubTab_OnClick"/>
            </StackPanel>
        </Border>

        <!-- ============ TAB 1 : Vue d'ensemble + Import ============ -->
        <ScrollViewer x:Name="OverviewRoot" Grid.Row="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel>
                <!-- Import card -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="IMPORTER UN RELEVÉ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" LineHeight="17" Margin="0,0,0,10">
                            Importez le relevé téléchargé de votre banque (PDF, CSV ou fichier texte),
                            puis importez le fichier ici. Les libellés sont classés automatiquement par vos régles.
                            Réimporter le même fichier n'ajoute pas de doublons.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ImportButton" Content="Importer un fichier…" Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="16,8" Click="ImportButton_OnClick"/>
                            <Button x:Name="ManualTxButton" Content="Ajouter une opération" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8" Margin="8,0,0,0" Click="ManualTxButton_OnClick"/>
                            <Button x:Name="OpenBankSiteButton" Content="Ouvrir Hello bank!" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8" Margin="8,0,0,0" Click="OpenBankSiteButton_OnClick"/>
                        </StackPanel>
                        <TextBlock Text="GUIDE — RÉCUPÉRER LE MOIS DERNIER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,4"/>
                        <StackPanel>
                            <TextBlock Text="1. Bouton « Ouvrir Hello bank! » ci-dessus : le navigateur doit atterrir sur une adresse qui commence par connexion.hellobank.fr. Numéro Client, Continuer, puis code secret." TextWrapping="Wrap" FontSize="11" LineHeight="17" Foreground="{StaticResource TextFaintBrush}"/>
                            <TextBlock Text="2. Dans le compte concerné, ouvrir le relevé / la liste des opérations." TextWrapping="Wrap" FontSize="11" LineHeight="17" Foreground="{StaticResource TextFaintBrush}"/>
                            <TextBlock Text="3. Choisir la période : du 1er du mois dernier au dernier jour du mois dernier." TextWrapping="Wrap" FontSize="11" LineHeight="17" Foreground="{StaticResource TextFaintBrush}"/>
                            <TextBlock Text="4. Ouvrir « MES DERNIERS DOCUMENTS » (les archives du compte) et télécharger le PDF du relevé (COMPTE DE CHÈQUES …). Le fichier atterrit dans le dossier Téléchargements." TextWrapping="Wrap" FontSize="11" LineHeight="17" Foreground="{StaticResource TextFaintBrush}"/>
                            <TextBlock Text="5. Revenir ici et cliquer « Importer un fichier… » pour le charger. Un même fichier peut être rechargé sans doublons." TextWrapping="Wrap" FontSize="11" LineHeight="17" Foreground="{StaticResource TextFaintBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="ImportStatus" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}"
                                  FontSize="11" LineHeight="16" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Period selector -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Période" Foreground="{StaticResource TextBrush}" FontSize="13"
                              FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="MonthPicker" Grid.Column="1" Style="{StaticResource DarkComboBoxStyle}"
                              SelectionChanged="MonthPicker_OnSelectionChanged"/>
                    <Button x:Name="RefreshOverviewButton" Grid.Column="2" Content="⟳" Width="30" Height="28" Padding="0"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="RefreshOverviewButton_OnClick"/>
                </Grid>

                <!-- Summary numbers: three cells, filled from code behind SummaryCell0/1/2 -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="SummaryCell0" Grid.Column="0"/>
                        <StackPanel x:Name="SummaryCell1" Grid.Column="1"/>
                        <StackPanel x:Name="SummaryCell2" Grid.Column="2"/>
                    </Grid>
                </Border>

                <!-- Category bars -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CATÉGORIES DU MOIS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Plan de référence :" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="3" x:Name="PlanPicker" Width="150" Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="PlanPicker_OnSelectionChanged" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" x:Name="AutoClassifyButton" Content="Classer auto" ToolTip="Classe automatiquement les dépenses d'aprés le marchand et les revenus (salaire, rembourserment, virement recu…). Ne touche pas aux lignes déja classées."
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" Click="AutoClassifyButton_OnClick"/>
                        </Grid>
                        <StackPanel x:Name="CategoryBarsPanel"/>
                        <TextBlock x:Name="OverviewEmptyText" Text="Aucune opération pour cette période. Importez un relevé ou ajoutez-en une à la main."
                                   Foreground="{StaticResource TextFaintBrush}" FontSize="12" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Income bars: a budget cannot be steered without seeing where the money coming in comes from -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="REVENUS DU MOIS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="IncomeBarsPanel"/>
                        <TextBlock x:Name="IncomeEmptyText" Text="Aucun revenu pour cette période. Le bouton « Classer auto » range salaires, rembourserments et virements recus."
                                   Foreground="{StaticResource TextFaintBrush}" FontSize="12" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Monthly expense vs income trend -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="TENDANCE DÉPENSES ET REVENUS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                        <StackPanel x:Name="TrendPanel"/>
                        <TextBlock x:Name="TrendEmptyText" Text="Assez peu de mois importés pour dessiner une tendance."
                                   Foreground="{StaticResource TextFaintBrush}" FontSize="12" FontStyle="Italic" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ TAB 2 : Opérations + Régles ============ -->
        <Grid x:Name="TransactionsRoot" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Operations list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,16,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="OPÉRATIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="6" Height="30">
                            <TextBox x:Name="TxSearch" Background="Transparent" Foreground="White" BorderThickness="0"
                                     VerticalContentAlignment="Center" Padding="8,0" CaretBrush="White"
                                     TextChanged="TxSearch_OnTextChanged"/>
                        </Border>
                        <Button Grid.Column="1" Content="＋ Ajouter" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,4" Margin="8,0,0,0" Click="ManualTxButton_OnClick"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <StackPanel x:Name="TxListPanel"/>
                            <TextBlock x:Name="TxEmptyText" Text="Aucune opération importée pour l'instant."
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" FontStyle="Italic" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Rules column -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="RÈGLES DE CLASSEMENT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" FontSize="11" LineHeight="15" Margin="0,4,0,0">
                            Un mot-clé trouvé dans un libellé classe l'opération dans la catégorie choisie —
                            y compris pour tout le catalogue déja importé.
                        </TextBlock>
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" CornerRadius="6" Height="28" Width="150" Margin="0,0,6,0">
                            <TextBox x:Name="RuleKeywordInput" Background="Transparent" Foreground="White" BorderThickness="0"
                                     VerticalContentAlignment="Center" Padding="8,0" CaretBrush="White"/>
                        </Border>
                        <Button Grid.Column="1" Content="＋ Régler" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12,4" Click="AddRuleButton_OnClick"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <StackPanel x:Name="RuleListPanel"/>
                            <TextBlock x:Name="RuleEmptyText" Text="Aucune régle." Foreground="{StaticResource TextFaintBrush}"
                                       FontSize="12" FontStyle="Italic" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ TAB 3 : Plans ============ -->
        <Grid x:Name="PlansRoot" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Plan list -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,16,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="PLANS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="NewPlanButton" Content="＋ Nouveau" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,3" Click="NewPlanButton_OnClick"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <StackPanel x:Name="PlanListPanel"/>
                            <TextBlock x:Name="PlanEmptyText" Text="Aucun plan. Créez-en un pour definir vos enveloppes."
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" FontStyle="Italic" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Plan detail -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="18">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PlanDetailTitle" Grid.Column="0" Text="Choisissez un plan" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="RenamePlanButton" Grid.Column="1" Content="Renomer" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4" Margin="8,0,0,0" Visibility="Collapsed" Click="RenamePlanButton_OnClick"/>
                        <Button x:Name="DeletePlanButton" Grid.Column="2" Content="✕" Width="28" Height="26" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Visibility="Collapsed" Click="DeletePlanButton_OnClick"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel>
                            <StackPanel x:Name="PlanLinesPanel"/>
                            <TextBlock x:Name="PlanLinesEmptyText" Text="Aucune enveloppe dans ce plan."
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="12" FontStyle="Italic" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
