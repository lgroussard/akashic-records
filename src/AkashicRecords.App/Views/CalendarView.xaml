<UserControl x:Class="AkashicRecords.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AkashicRecords.App.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Category palette (§57): one fixed color per agenda source, shared by the day dots,
             the legend, the agenda rows and the notification toast. -->
        <SolidColorBrush x:Key="BirthdayBrush" Color="#F06CA8"/>
        <SolidColorBrush x:Key="SortieBrush" Color="#E0823C"/>
        <SolidColorBrush x:Key="PlanBrush" Color="#4ADE80"/>
        <SolidColorBrush x:Key="VoyageBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="RendezvousBrush" Color="#C084FC"/>
        <SolidColorBrush x:Key="AutreBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="DeadlineBrush" Color="#F2C14E"/>

        <!-- Chip look for ToggleButtons (all-day / recurring / settings switches). Separate from
             ChipButtonStyle because that one targets Button — applying it to a ToggleButton is a
             XAML parse error (known dialect trap). -->
        <Style x:Key="CheckChipStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Background" Value="{StaticResource Surface1Brush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title + subtitle -->
        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <TextBlock Text="Calendrier" FontSize="22" FontWeight="800" Foreground="White" Margin="0,0,0,2"/>
            <TextBlock Text="Vos échéances de projets, les anniversaires de vos proches et vos sorties, au même endroit."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,12"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left: month grid + legend ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,0,16,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <DockPanel LastChildFill="True">
                    <!-- Month header + prev/next/today (top). LastChildFill=False: with the default True,
                         the nav row (last child) filled whatever was left of the header and slid left and
                         right as "Novembre 2026" grew or shrank against "Mai 2026". Docked right with no
                         fill, it stays pinned to the card's edge whatever the label says. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock x:Name="MonthHeader" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="TodayButton" Content="Aujourd'hui" Style="{StaticResource MiniButtonStyle}"
                                    Click="TodayButton_OnClick" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Content="‹" Style="{StaticResource SecondaryButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="PreviousMonthButton_OnClick" Margin="0,0,4,0"/>
                            <Button Content="›" Style="{StaticResource SecondaryButtonStyle}" Width="28" Height="28" Padding="0"
                                    Click="NextMonthButton_OnClick"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Legend (bottom): one dot per category color -->
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource BirthdayBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Anniversaires" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SortieBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Sorties" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource PlanBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Plans" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource VoyageBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Voyages" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource RendezvousBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Rendez-vous" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AutreBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Autre" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource DeadlineBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Échéances" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Month grid (fills the card). Built in code (see BuildMonthGrid): a 7x6
                         UniformGrid of large cells that stretch to fill the card, each showing its
                         day number and inline event chips — unlike the native Calendar control,
                         which couldn't stretch and offered no room for content. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <UniformGrid Grid.Row="0" Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="Lun" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mar" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mer" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Jeu" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ven" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sam" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Dim" Foreground="{StaticResource TextFaintBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </UniformGrid>
                        <UniformGrid Grid.Row="1" x:Name="MonthGrid" Rows="6" Columns="7"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== Right: day agenda + upcoming (or the form/settings panel over them) ===== -->
            <Grid Grid.Column="1">

                <!-- Default pane: day agenda + upcoming horizon -->
                <Grid x:Name="AgendaRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Actions + source filters -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="FilterBirthdays" Content="Anniversaires" Tag="Birthday" IsChecked="True"
                                          Style="{StaticResource SubTabStyle}" Click="FilterChip_OnClick"/>
                            <ToggleButton x:Name="FilterEvents" Content="Événements" Tag="Event" IsChecked="True"
                                          Style="{StaticResource SubTabStyle}" Click="FilterChip_OnClick"/>
                            <ToggleButton x:Name="FilterDeadlines" Content="Échéances" Tag="Deadline" IsChecked="True"
                                          Style="{StaticResource SubTabStyle}" Click="FilterChip_OnClick"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="NewBirthdayButton" Content="+ Anniversaire" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="NewBirthdayButton_OnClick" Margin="0,0,6,0"/>
                            <Button x:Name="NewEventButton" Content="+ Événement" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="NewEventButton_OnClick" Margin="0,0,6,0"/>
                            <Button x:Name="SettingsButton" Content="⚙ Réglages" Style="{StaticResource MiniButtonStyle}"
                                    Click="SettingsButton_OnClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Selected-day card: sizes to content, capped so the upcoming card below keeps room -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20" MaxHeight="430"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="SelectedDayHeader" DockPanel.Dock="Top" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <StackPanel>
                                    <StackPanel x:Name="DayItemsPanel"/>
                                    <TextBlock x:Name="DayEmptyText" Text="Rien ce jour-là. Ajoutez un anniversaire ou un événement."
                                               Foreground="{StaticResource TextFaintBrush}" FontSize="12.5" Margin="0,4,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Upcoming horizon card: fills the remaining height -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="20" Margin="0,14,0,0"
                            HorizontalAlignment="Stretch">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="À VENIR (30 JOURS)" DockPanel.Dock="Top" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <StackPanel>
                                    <StackPanel x:Name="UpcomingPanel"/>
                                    <TextBlock x:Name="UpcomingEmptyText" Text="Rien dans les 30 prochains jours."
                                               Foreground="{StaticResource TextFaintBrush}" FontSize="12.5" Margin="0,4,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Event / birthday form pane (over the agenda) -->
                <Border x:Name="FormRoot" Style="{StaticResource CardBorderStyle}" Padding="22" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="FormTitle" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,14"/>

                        <!-- Birthday form -->
                        <StackPanel x:Name="BirthdayFormPanel" Visibility="Collapsed">
                            <TextBlock Text="Nom" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="BirthdayNameInput" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Date (le jour et le mois comptent, l'année sert à l'âge)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <views:MiniDatePicker x:Name="BirthdayDateInput" Width="190"/>
                                <TextBox x:Name="BirthdayYearInput" Style="{StaticResource DarkTextBoxStyle}" Width="80" Margin="10,0,0,0"
                                         ToolTip="Année de naissance (optionnelle, pour afficher l'âge)"/>
                            </StackPanel>
                            <TextBlock Text="Note (optionnelle)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="BirthdayNotesInput" Style="{StaticResource DarkTextBoxStyle}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="52" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                            <TextBlock Text="Éléments liés (poèmes, projets, observations… )" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="BirthdayLinksPanel" Margin="0,0,0,4"/>
                            <Button Content="+ Lier un élément" Style="{StaticResource MiniButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,0,0,4" Click="AddLinkButton_OnClick"/>
                        </StackPanel>

                        <!-- Event form -->
                        <StackPanel x:Name="EventFormPanel" Visibility="Collapsed">
                            <TextBlock Text="Titre" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="EventTitleInput" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Catégorie" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <!-- Explicit ItemTemplate instead of DisplayMemberPath: the custom
                                         DarkComboBoxStyle doesn't forward the display-member template
                                         to the closed box (known dialect trap). -->
                                    <ComboBox x:Name="EventKindPicker" Style="{StaticResource DarkComboBoxStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="Date" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <views:MiniDatePicker x:Name="EventDateInput"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Heure (HH:MM)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <ToggleButton x:Name="EventAllDayToggle" Content="Toute la journée" Style="{StaticResource CheckChipStyle}"
                                                  Checked="EventAllDayToggle_OnChecked" Unchecked="EventAllDayToggle_OnUnchecked"
                                                  Margin="0,0,0,6"/>
                                    <TextBox x:Name="EventTimeInput" Style="{StaticResource DarkTextBoxStyle}" Width="90" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Fin (facultatif, multi-jours)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <views:MiniDatePicker x:Name="EventEndDateInput"/>
                                </StackPanel>
                                <ToggleButton x:Name="EventSameDurationToggle" Grid.Column="1" Content="Même durée que le dernier créé"
                                              Style="{StaticResource CheckChipStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                              ToolTip="Reprend le nombre de jours de votre dernier événement" Click="SameDuration_OnClick"/>
                            </Grid>
                            <TextBlock Text="Lieu (optionnel)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="EventLocationInput" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="Notes (optionnelles)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="EventNotesInput" Style="{StaticResource DarkTextBoxStyle}" AcceptsReturn="True"
                                     TextWrapping="Wrap" MinHeight="52" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                            <TextBlock Text="Éléments liés (poèmes, projets, observations… )" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                            <WrapPanel x:Name="EventLinksPanel" Margin="0,0,0,4"/>
                            <Button Content="+ Lier un élément" Style="{StaticResource MiniButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,0,0,10" Click="AddLinkButton_OnClick"/>
                            <ToggleButton x:Name="EventRecurringToggle" Content="Se répète chaque année" Style="{StaticResource CheckChipStyle}"
                                         HorizontalAlignment="Left" Margin="0,0,0,16"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SaveFormButton" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveFormButton_OnClick" Margin="0,0,8,0"/>
                            <Button x:Name="CancelFormButton" Content="Annuler" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CancelFormButton_OnClick"/>
                            <Button x:Name="DeleteFormButton" Content="Supprimer" Style="{StaticResource MiniButtonStyle}"
                                    Click="DeleteFormButton_OnClick" Margin="16,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notification settings pane (over the agenda) -->
                <Border x:Name="SettingsRoot" Style="{StaticResource CardBorderStyle}" Padding="22" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Notifications" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"
                                   Text="Délai de rappel avant chaque type (en minutes) : 0 = le jour même à 9h, 120 = 2h avant l'heure de l'événement, 1440 = la veille, 10080 = une semaine avant. -1 désactive le rappel pour ce type."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <ToggleButton x:Name="SettingsNotificationsToggle" Content="Notifications" Style="{StaticResource CheckChipStyle}"
                                          Margin="0,0,8,0"/>
                            <ToggleButton x:Name="SettingsDailyToastToggle" Content="Toast du matin" Style="{StaticResource CheckChipStyle}"/>
                        </StackPanel>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,14,10">
                                <TextBlock Text="Anniversaires (min)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="LeadBirthdayInput" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Échéances de projets (min)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="LeadDeadlineInput" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,10">
                                <TextBlock Text="Sorties (min)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="LeadSortieInput" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Plans (min)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="LeadPlanInput" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,10">
                                <TextBlock Text="Voyages (min)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="LeadVoyageInput" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Rendez-vous (min)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="LeadRendezvousInput" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Autre (min)" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="LeadAutreInput" Style="{StaticResource DarkTextBoxStyle}"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveSettingsButton_OnClick" Margin="0,0,8,0"/>
                            <Button Content="Fermer" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="CancelSettingsButton_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Link picker: reuses the global search so an event can point at any item of the app
             (poem, project, observation, photo…). Picking a row stores the hit as a link chip; the
             ↗ button opens the item directly without linking it. -->
        <Popup x:Name="LinkPickerPopup" Placement="Mouse" StaysOpen="False" Focusable="True"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="440" Background="#F21A1A2E" BorderBrush="#553B82F6" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Lier un élément de l'application" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    <TextBox x:Name="LinkSearchInput" Style="{StaticResource DarkTextBoxStyle}"
                             TextChanged="LinkSearchInput_OnTextChanged" Margin="0,0,0,8"/>
                    <ListBox x:Name="LinkResultsList" MaxHeight="320" Background="Transparent"
                             BorderThickness="0" Foreground="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="LinkResult_OnClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Tip}">
                                    <Border Width="46" Height="46" CornerRadius="5" Margin="0,0,9,0"
                                            Background="{StaticResource Surface2Brush}"
                                            Visibility="{Binding ThumbVisibility}">
                                        <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" MaxWidth="300">
                                        <TextBlock Text="{Binding Section}" Foreground="#7FB0FF" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Snippet}" Foreground="#AAAAAA" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Content="↗" Style="{StaticResource MiniButtonStyle}" Padding="7,3"
                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                            ToolTip="Ouvrir cet élément"
                                            Tag="{Binding}" Click="OpenResultButton_OnClick"
                                            PreviewMouseLeftButtonDown="OpenResult_PreviewDown"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="LinkNoResultsText" Text="Aucun résultat." Foreground="{StaticResource TextFaintBrush}"
                               FontSize="12" Margin="2,4" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
