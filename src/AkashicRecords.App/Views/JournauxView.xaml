<UserControl x:Class="AkashicRecords.App.Views.JournauxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:System="clr-namespace:System;assembly=System.Private.CoreLib"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Each journal type has its own philosophy/UI per the spec - this switches between them -->
        <Border Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,16" Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="PersonalJournalTab" Content="Journal personnel" Tag="Personal" IsChecked="True"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
                <ToggleButton x:Name="RecipesJournalTab" Content="Journal de recettes" Tag="Recipes"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
                <ToggleButton x:Name="PoetryJournalTab" Content="Recueil de poésie" Tag="Poetry"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
                <ToggleButton x:Name="ArtisticJournalTab" Content="Archive artistique" Tag="Artistic"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Journal personnel: a calendar (chips mark days with an entry) + a book you page through,
                 one page per entry, in chronological order - opens on today so you can write immediately -->
            <Grid x:Name="PersonalJournalRoot">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Calendar card: month header + prev/next + a compact 7-day grid, "＋ Aujourd'hui" pinned bottom -->
                <Border Grid.Column="0" Width="300" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,20,0" VerticalAlignment="Stretch">
                    <DockPanel LastChildFill="True">
                        <!-- Month header + prev/next (top) -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="MonthHeader" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="‹" Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0"
                                        Click="PreviousMonthButton_OnClick" Margin="0,0,4,0"/>
                                <Button Content="›" Style="{StaticResource SecondaryButtonStyle}" Width="26" Height="26" Padding="0"
                                        Click="NextMonthButton_OnClick"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Calendar fills the remaining space (must be the last child so it doesn't overlap the header) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="L" Foreground="{StaticResource TextFaintBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="M" Foreground="{StaticResource TextFaintBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="M" Foreground="{StaticResource TextFaintBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="J" Foreground="{StaticResource TextFaintBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="V" Foreground="{StaticResource TextFaintBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="S" Foreground="{StaticResource TextFaintBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="D" Foreground="{StaticResource TextFaintBrush}" FontSize="11" HorizontalAlignment="Center"/>
                            </Grid>
                            <Calendar x:Name="EntryCalendar" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      SelectedDatesChanged="EntryCalendar_OnSelectedDatesChanged"
                                      CalendarDayButtonStyle="{StaticResource EntryDayButtonStyle}"
                                      Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Entry page: title (underline) · date · body · tags (chips) · photos -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹" Click="PreviousEntryButton_OnClick" Width="30" Height="30"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontSize="18"/>
                                <Button Content="›" Click="NextEntryButton_OnClick" Width="30" Height="30"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontSize="18"/>
                                <Button x:Name="DeleteEntryButton" Content="Supprimer cette entrée" Style="{StaticResource MiniButtonStyle}"
                                        Click="DeleteEntryButton_OnClick" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox x:Name="EntryTitleInput" LostFocus="EntryTitleInput_OnLostFocus"
                                     FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                     Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppBorderBrush}"
                                     Padding="0,6" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" x:Name="PageDateText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,6,0,12"/>

                        <TextBox Grid.Row="2" x:Name="EntryTextInput" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="14.5"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,14" LostFocus="EntryTextInput_OnLostFocus"/>

                        <StackPanel Grid.Row="3" Margin="0,0,0,12">
                            <TextBlock Text="Tags" Style="{StaticResource PanelSectionHeaderStyle}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="EntryTagsPanel"/>
                            <Grid>
                                <TextBox x:Name="EntryTagsInput" LostFocus="EntryTagsInput_OnLostFocus"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                         FontSize="12.5" Padding="2,4" TextChanged="EntryTagsInput_OnTextChanged"/>
                                <TextBlock x:Name="EntryTagsPlaceholder" Text="+ tag" Foreground="{StaticResource TextFaintBrush}"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,4,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="PHOTOS" Style="{StaticResource PanelSectionHeaderStyle}" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="EntryPhotosPanel" Margin="0,0,0,12"/>
                            <Button x:Name="AddEntryPhotoButton" Content="+" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="AddEntryPhotoButton_OnClick" Width="48" Height="48" FontSize="24"
                                    Padding="0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Journal de recettes: a personal recipe book (sidebar list + one recipe "page" at a time),
                 not a food-management system - filter by category chip, search, or ingredient text -->
            <Grid x:Name="RecipesRoot" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: search, category filter chips, recipe list, "new recipe" CTA pinned bottom -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,20,0" VerticalAlignment="Stretch">
                    <DockPanel LastChildFill="False">
                        <!-- Search bar: input with overlaid in-box placeholder (visible only while empty) -->
                        <Grid DockPanel.Dock="Top">
                            <TextBox x:Name="RecipeSearchInput" Background="{StaticResource Surface2Brush}"
                                     Foreground="{StaticResource TextBrush}" FontSize="13" Padding="10,8,8,8" Height="36"
                                     BorderThickness="0"
                                     TextChanged="RecipeSearchInput_OnTextChanged" VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="RecipeSearchPlaceholder" Text="Titre, ingrédient…" IsHitTestVisible="False"
                                       Foreground="{StaticResource TextFaintBrush}" FontSize="13" VerticalAlignment="Center"
                                       Margin="11,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=RecipeSearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Category filter chips -->
                        <WrapPanel DockPanel.Dock="Top" x:Name="RecipeCategoryFilterPanel" Margin="0,12,0,10"/>

                        <!-- Recipe list -->
                        <ListBox DockPanel.Dock="Top" x:Name="RecipeTitleList"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 SelectionChanged="RecipeTitleList_OnSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBg" Property="Background" Value="#2A3458"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBg" Property="Background" Value="#1FFFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" CornerRadius="8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                                       FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Margin="0,2,0,0" Foreground="{StaticResource TextMutedBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RecipeSubtitleConverter}">
                                                        <Binding Path="Category"/>
                                                        <Binding Path="Ingredients"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- "＋ Nouvelle recette" CTA pinned to the bottom -->
                        <Button DockPanel.Dock="Bottom" x:Name="NewRecipeButton" Content="＋ Nouvelle recette"
                                Style="{StaticResource PrimaryButtonStyle}" Height="40" HorizontalAlignment="Stretch"
                                Margin="0,12,0,0" Click="NewRecipeButton_OnClick"/>
                    </DockPanel>
                </Border>

                <!-- Recipe page: cover, title, category chip, ingredients, preparation -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.4*"/>
                            <RowDefinition Height="1.4*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: prev/next pinned to the edges + recipe title centered between them -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀ Précédent" Style="{StaticResource SecondaryButtonStyle}" Click="PreviousRecipeButton_OnClick" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" x:Name="RecipePageTitleText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="17" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="16,0"/>
                            <Button Grid.Column="2" Content="Suivant ▶" Style="{StaticResource SecondaryButtonStyle}" Click="NextRecipeButton_OnClick" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Cover photo + choose/remove button -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <Image x:Name="RecipeCoverImage" Height="120" Margin="0,0,0,8"
                                   Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choisir une photo…" Style="{StaticResource SecondaryButtonStyle}" Click="SetRecipeCoverButton_OnClick"/>
                                <Button x:Name="RemoveRecipeCoverButton" Content="Retirer la photo" Style="{StaticResource MiniButtonStyle}" Click="RemoveRecipeCoverButton_OnClick"
                                        Margin="12,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Title + category row: two compact labeled inputs, left-aligned per the mockup -->
                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="258"/>
                                <ColumnDefinition Width="248"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Titre" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="RecipeTitleInput" LostFocus="RecipeField_OnLostFocus"
                                         FontSize="14" Foreground="{StaticResource TextBrush}"
                                         Background="{StaticResource Surface2Brush}"
                                         BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}"
                                         Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="37,0,0,0">
                                <TextBlock Text="Catégorie" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="RecipeCategoryInput" LostFocus="RecipeField_OnLostFocus"
                                         Foreground="{StaticResource TextBrush}"
                                         Background="{StaticResource Surface2Brush}"
                                         BorderThickness="1" BorderBrush="{StaticResource AppBorderBrush}"
                                         Padding="8,6"/>
                            </StackPanel>
                        </Grid>

                        <!-- Ingrédients: tall field, stretches to fill the card (mockup proportion) -->
                        <DockPanel Grid.Row="3" Margin="0,0,0,14" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Ingrédients" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeIngredientsInput" Style="{StaticResource DarkTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MinHeight="80"
                                     LostFocus="RecipeField_OnLostFocus"/>
                        </DockPanel>

                        <!-- Préparation: tall field, stretches to fill the card -->
                        <DockPanel Grid.Row="4" Margin="0,0,0,14" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="Préparation" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeInstructionsInput" Style="{StaticResource DarkTextBoxStyle}" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MinHeight="100"
                                     LostFocus="RecipeField_OnLostFocus"/>
                        </DockPanel>

                        <!-- Notes personnelles -->
                        <StackPanel Grid.Row="5" Margin="0,0,0,14">
                            <TextBlock Text="Notes personnelles" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeNotesInput" Style="{StaticResource DarkTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     LostFocus="RecipeField_OnLostFocus"/>
                        </StackPanel>

                        <!-- Tags -->
                        <StackPanel Grid.Row="6" Margin="0,0,0,14">
                            <TextBlock Text="Tags (séparés par des virgules)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeTagsInput" Style="{StaticResource DarkTextBoxStyle}" LostFocus="RecipeField_OnLostFocus"/>
                        </StackPanel>

                        <!-- Delete -->
                        <Button Grid.Row="7" x:Name="DeleteRecipeButton" Content="Supprimer la recette" Style="{StaticResource MiniButtonStyle}" Click="DeleteRecipeButton_OnClick" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Recueil de poésie: a notebook, not a canvas - poems optionally grouped into recueils -->
            <Grid x:Name="PoetryRoot" Visibility="Collapsed" PreviewKeyDown="PoetryRoot_OnPreviewKeyDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- The former left rail is gone from the layout: poe3's shelf is full-bleed and poe8's book
                     carries its own poem list, so no column may be held open. Its controls are re-homed — the
                     search and the create action live in the book's left card, the recueil management in the ⋯
                     fly-out declared at the bottom of this region. -->
                <Grid Grid.Column="0" x:Name="PoetryRailHost" Width="0"/>

                <!-- The main stage: either the bookshelf (covers) or the open book (recueil + poems). -->
                <Grid Grid.Column="1">
                    <!-- poe8's book is a two-panel spread: the poem list on the left, the poem page on the
                         right, both visible at once. The stage's grid carries that split; the bookshelf spans
                         all of it, the book's list card sits in column 0 and the poem page in column 2. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BOOKSHELF: horizontal scroll of recueil covers. -->
                    <Grid x:Name="PoetryBookshelf" Grid.RowSpan="2" Grid.ColumnSpan="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header and the per-cover management bar share the shelf's first row as a stack, so the bar
                             pushes the covers down when it appears instead of overlapping them. -->
                        <StackPanel Grid.Row="0">
                        <DockPanel Margin="0,0,0,14" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" x:Name="BookshelfTitle" Text="Bibliothèque" FontSize="20"
                                       FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock DockPanel.Dock="Left" Text="Choisissez un recueil pour l'ouvrir" FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <!-- Creating a recueil belongs on the shelf itself, not behind the fly-out: the new cover
                                 appears the moment it is committed, so the action is visible where its result lives.
                                 Same shape as the create rows in the other journals (input + one button). -->
                            <StackPanel DockPanel.Dock="Right" x:Name="ShelfNewRecueilPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="ShelfNewRecueilInput" Style="{StaticResource DarkTextBoxStyle}" Width="160" Height="32"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="Nom du nouveau recueil"
                                         PreviewKeyDown="ShelfNewRecueilInput_OnPreviewKeyDown"/>
                                <!-- A MinWidth and explicit padding keep the label clear of the button's edges: sized to
                                     its bare content it read as clipped, the text vanishing into the padding. -->
                                <Button Content="+ Recueil" Style="{StaticResource SecondaryButtonStyle}" Height="32" MinWidth="100"
                                        Padding="16,0" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                                        Click="NewRecueilButton_OnClick" ToolTip="Créer le recueil sur l'étagère"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Per-cover management, revealed by the ✎ chip on a cover. Deliberately NOT part of the
                             create control and NOT part of the fly-out: renaming and deleting a book are actions on
                             that book, so they appear on the book, prefilled with its own title. -->
                        <Border x:Name="ShelfManageBar" Visibility="Collapsed" Style="{StaticResource CardBorderStyle}"
                                Background="{StaticResource Surface2Brush}" Padding="12,8" Margin="0,0,0,14"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Renommer" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="ShelfRenameInput" Style="{StaticResource DarkTextBoxStyle}" Width="200" Height="28"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center"
                                         PreviewKeyDown="ShelfRenameInput_OnPreviewKeyDown"/>
                                <Button Content="Renommer" Style="{StaticResource MiniButtonStyle}" Margin="0,0,6,0"
                                        Click="ShelfRenameButton_OnClick"/>
                                <Button Content="Annuler" Style="{StaticResource MiniButtonStyle}" Margin="0,0,0,0"
                                        Click="ShelfManageCancel_OnClick"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- The shelf itself: poe3 rules a thin baseline directly under the row of books, with
                             all the free space left empty below. Declared before the covers, and pinned to the
                             top of the filler row, so it lands right under them instead of at the page bottom. -->
                        <Rectangle Grid.Row="2" Height="2" VerticalAlignment="Top" Margin="2,0,2,0"
                                   Fill="{StaticResource BorderStrongBrush}" RadiusX="1" RadiusY="1"/>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Padding="0,8,0,16" MouseWheel="BookshelfScrollViewer_MouseWheel">
                            <ItemsControl x:Name="RecueilCoverList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A cover, as poe3 draws every book: a flush dark spine strip pinned down
                                             the whole left edge, then the cover face carrying the title and the poem
                                             count centred together. Height pinned so the row of books stands alike. -->
                                        <Border Width="190" Height="210" Margin="0,0,22,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="RecueilCover_OnClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="9"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#3F000000" CornerRadius="8,0,0,8"
                                                        Visibility="{Binding SpineVisibility}"/>
                                                <Border Grid.Column="1" Background="{Binding CoverBrush}" CornerRadius="0,8,8,0"
                                                        BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16,14">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="White"
                                                                   FontFamily="Georgia" FontSize="16" FontWeight="Bold"
                                                                   FontStyle="{Binding TitleFontStyle}"
                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding PoemCountText}"
                                                                   Foreground="#CCFFFFFF" FontSize="11" HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <!-- Per-cover management, floating on the cover face's top-right corner.
                                                     Drawn muted at rest rather than hover-revealed: this dialect exposes
                                                     no verified hover event on a data-template element, so a hover-only
                                                     chip risks never appearing at all, which is worse than a discreet
                                                     one. The view-model collapses both chips for the catch-all (which
                                                     must always exist to receive unassigned poems) and for the action card. -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,7,0"
                                                          Visibility="{Binding ManageButtonVisibility}">
                                                    <Button Content="✎" Width="24" Height="24"
                                                            Style="{StaticResource MiniButtonStyle}"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Click="RenameRecueilCover_OnClick"
                                                            ToolTip="Renommer ce recueil"/>
                                                    <Button Content="✕" Width="24" Height="24" Margin="4,0,0,0"
                                                            Style="{StaticResource MiniButtonStyle}"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Click="DeleteRecueilCover_OnClick"
                                                            ToolTip="Supprimer ce recueil"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- OPEN BOOK: the selected recueil's summary + its poems. -->
                    <Grid x:Name="PoetryBook" Visibility="Collapsed" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="3">
                        <!-- Same split as the stage: the list card owns column 0, the poem page column 2, so both
                             stand at once the way poe8 draws them. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Book header, as poe8 rules it: a plain "← Bibliothèque" chip, then the recueil
                             title in large serif, and at the far right a single ⋯ button that unfolds the
                             recueil's own management (rename, summary, delete) — kept out of the way so the
                             header stays as spare as the mockup's. -->
                        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14" LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="← Bibliothèque" x:Name="BookshelfBackButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BookshelfBackButton_OnClick" Margin="0,0,16,0"
                                    ToolTip="Retour à l'étagère"/>
                            <TextBlock DockPanel.Dock="Left" x:Name="BookTitle" Text="" FontSize="24" FontFamily="Georgia"
                                       FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <ToggleButton DockPanel.Dock="Right" x:Name="PoetryMenuButton" Content="⋯" Width="34" Height="30"
                                         Style="{StaticResource MiniToggleButtonStyle}" Click="PoetryMenuButton_OnToggle"
                                         ToolTip="Gérer ce recueil"/>
                        </DockPanel>

                        <!-- The recueil's own management controls (rename, summary, delete) live in the ⋯
                             fly-out below rather than in a header strip: poe8's header holds nothing but the
                             back chip and the title, and the fly-out is the one place the user goes to manage. -->

                        <!-- The book's left card: the recueil's poems as a vertical list, poe8-style (bold serif
                             title over a muted "Recueil : …" line), with the create action pinned at its foot.
                             The search box and the new-poem field moved here out of the dissolved rail. -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <DockPanel LastChildFill="True">
                                <!-- Search, with the in-box placeholder shown only while empty (the dialect's
                                     TextBox has no PlaceholderText property). -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <TextBox x:Name="PoemSearchInput" Style="{StaticResource DarkTextBoxStyle}" Height="34"
                                           TextChanged="PoemSearchInput_OnTextChanged" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Chercher un poème…" IsHitTestVisible="False"
                                             Foreground="{StaticResource TextFaintBrush}" FontSize="12" VerticalAlignment="Center"
                                             Margin="11,0,0,0" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PoemSearchInput}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- The create row, hidden by default: a poem is only ever created from inside an
                                     open recueil, which is where this button lives. -->
                                <!-- One control, no field above it: a new poem is created straight away under the
                                     placeholder title "Nouveau poème" and opens for editing, where the title is typed.
                                     A blank title field above a button asked for a name before the thing existed. -->
                                <Button DockPanel.Dock="Bottom" x:Name="NewPoemPanel" Content="+ Nouveau poème"
                                        Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="38"
                                        Margin="0,12,0,0" Click="NewPoemButton_OnClick"
                                        ToolTip="Créer un poème dans ce recueil"/>

                                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                                    </ScrollViewer.Resources>
                                    <ItemsControl x:Name="PoemCardList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- One row of the list, exactly as poe8 draws it: the title in bold
                                                     serif with the anthology named underneath in muted text. -->
                                                <Border Padding="0,0,0,16" Cursor="Hand" Background="Transparent"
                                                        MouseLeftButtonUp="PoemCard_OnClick">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                                                 FontFamily="Georgia" FontSize="14" FontWeight="Bold"
                                                                 TextWrapping="Wrap"/>
                                                        <TextBlock Margin="0,3,0,0" Text="{Binding RecueilLabel}"
                                                                 Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- POEM EDITOR: the open poem page, poe8's right-hand card. It lives in the stage's third
                         column so it stands BESIDE the book's poem list instead of replacing it. -->
                    <!-- The card keeps its full stage width — the toolbar and the organisational row need that room.
                         Only the verse itself is bounded and centred below, for legibility: the complaint was the text
                         column running too wide, not the card. -->
                    <Grid x:Name="PoemEditor" Visibility="Collapsed" Grid.Row="1" Grid.Column="2">
                        <!-- The whole card is the typing surface, not just the glyphs already written:
                             the verse box only stretches over its own bounds, so the empty page below the
                             text used to swallow clicks. The card takes the click and drops the caret in
                             the verse, unless it was raised by a real control (button, combo, another field). -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="28,20" x:Name="PoemEditorCard"
                                MouseLeftButtonDown="PoemEditorCard_OnClick"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Paging: jump to the previous/next poem in the current recueil. -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Left" Content="◀ Préc." Click="PreviousPoemButton_OnClick"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"/>
                                    <Button DockPanel.Dock="Right" Content="Suiv. ▶" Click="NextPoemButton_OnClick"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"/>
                                    <TextBlock HorizontalAlignment="Center"/>
                                </DockPanel>

                                <!-- Title, as a heading. -->
                                <TextBox Grid.Row="1" x:Name="PoemTitleInput" LostFocus="PoemField_OnLostFocus"
                                         TextChanged="PoemTitleInput_OnTextChanged"
                                         FontFamily="Georgia" FontSize="26" FontWeight="Bold" TextAlignment="Center"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                         TextWrapping="Wrap" Margin="0,0,0,4"/>

                                <Image x:Name="PoemImage" Grid.Row="2" MaxHeight="180" Margin="0,4,0,12"
                                       Stretch="Uniform" HorizontalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Formatting toolbar. -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ToggleButton x:Name="PoemAlignLeftButton" Content="⯇≡" Tag="Left" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,2,0"/>
                                    <ToggleButton x:Name="PoemAlignCenterButton" Content="≡" Tag="Center" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,2,0"/>
                                    <ToggleButton x:Name="PoemAlignRightButton" Content="≡⯈" Tag="Right" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,2,0"/>
                                    <ToggleButton x:Name="PoemAlignJustifyButton" Content="☰" Tag="Justify" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,16,0"/>
                                    <!-- Two independent layout axes: the window WIDTH (the column the typing box
                                         occupies, base 300, ±40) and the inner page MARGIN below. One control could
                                         not carry both, which is what made the old single margin feel broken. -->
                                    <TextBlock Text="Largeur" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="−" ToolTip="Rétrécir la fenetre" Style="{StaticResource MiniButtonStyle}" Click="PoemWidthDecreaseButton_OnClick" Padding="8,2" Margin="0,0,2,0"/>
                                    <TextBlock x:Name="PoemWidthText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,2,0"/>
                                    <Button Content="+" ToolTip="Élargir la fenetre" Style="{StaticResource MiniButtonStyle}" Click="PoemWidthIncreaseButton_OnClick" Padding="8,2" Margin="0,0,4,0"/>
                                    <Button Content="0" ToolTip="Revenir à 900" Style="{StaticResource MiniButtonStyle}" Click="PoemWidthResetButton_OnClick" Padding="8,2" Margin="0,0,12,0"/>
                                    <TextBlock Text="Marges" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="−" Style="{StaticResource MiniButtonStyle}" Click="PoemMarginDecreaseButton_OnClick" Padding="8,2" Margin="0,0,2,0"/>
                                    <Button Content="+" Style="{StaticResource MiniButtonStyle}" Click="PoemMarginIncreaseButton_OnClick" Padding="8,2" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="PoemMarginText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,12,0"/>
                                    <Button Content="0" Style="{StaticResource MiniButtonStyle}" Click="PoemMarginResetButton_OnClick" Padding="8,2" Margin="0,0,12,0"/>
                                    <TextBlock Text="Police" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="A−" x:Name="PoemFontSizeDecreaseButton" Style="{StaticResource MiniButtonStyle}" Click="PoemFontSizeDecreaseButton_OnClick" Margin="0,0,2,0"/>
                                    <Button Content="A+" x:Name="PoemFontSizeIncreaseButton" Style="{StaticResource MiniButtonStyle}" Click="PoemFontSizeIncreaseButton_OnClick" Margin="0,0,12,0"/>
                                    <ToggleButton Content="B" x:Name="PoemBoldButton" FontWeight="Bold" Click="PoemBoldButton_OnClick" Style="{StaticResource MiniToggleButtonStyle}" Margin="0,0,2,0"/>
                                    <ToggleButton Content="I" x:Name="PoemItalicButton" FontStyle="Italic" Click="PoemItalicButton_OnClick" Style="{StaticResource MiniToggleButtonStyle}" Margin="0,0,2,0"/>
                                    <ComboBox x:Name="PoemFontFamilyCombo" Width="100" Style="{StaticResource DarkComboBoxStyle}"
                                              SelectionChanged="PoemFontFamilyCombo_OnSelectionChanged"/>
                                    <TextBlock x:Name="PoemFontSizeText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,0"/>
                                </StackPanel>

                                <!-- The poem text. Tab must insert a tabulation (a verse indent) rather than move the
                                     focus away: this dialect ships no AcceptsTab on TextBox (same absent member as the
                                     PlaceholderText trap), so the key is routed through PreviewKeyDown, the same way
                                     CanvasRoot and the reference overlay already take their keys in this file. -->
                                <!-- The reading column. Stretch on BOTH axes so it fills exactly the room the card
                                     leaves between the toolbar and the bottom row: Center would size the width to the
                                     (often empty) text — a sliver — and a fixed centred Height left dead bands. The
                                     painted Surface2 background is what makes the whole rectangle hit-testable (a
                                     Transparent one followed only the glyphs). MinHeight 300 is the floor it never
                                     sinks below. The "Marges" toolbar control drives the INTERNAL padding (see
                                     ApplyPoemFormatting): it breathes the verse away from the frame — its page
                                     margin — over a 14/12 base, rather than resizing the rectangle itself. -->
                                <TextBox Grid.Row="4" x:Name="PoemTextInput" TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="{StaticResource Surface2Brush}" CaretBrush="#FFFFFFFF"
                                         BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                         Padding="14,12" MinHeight="300" Width="900"
                                         HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                         Foreground="{StaticResource TextBrush}" FontSize="15"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         PreviewKeyDown="PoemTextInput_OnPreviewKeyDown"
                                         LostFocus="PoemField_OnLostFocus"/>

                                <!-- Organizational row. -->
                                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Recueil" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <!-- An explicit item template, not DisplayMemberPath: the closed box of a
                                         DarkComboBoxStyle combo is templated off SelectionBoxItemTemplate, which a
                                         DisplayMemberPath does not propagate, so the selection fell back to the
                                         POCO's ToString() ("AkashicRecords.Domain.Re…"). An ItemTemplate is forwarded. -->
                                    <ComboBox x:Name="PoemRecueilPicker" Style="{StaticResource DarkComboBoxStyle}" Width="170" FontSize="11"
                                              SelectionChanged="PoemRecueilPicker_OnSelectionChanged" Margin="0,0,12,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                                         FontSize="11" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Tags" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="PoemTagsInput" Style="{StaticResource DarkTextBoxStyle}" Width="160" FontSize="11" LostFocus="PoemField_OnLostFocus" Margin="0,0,12,0"/>
                                    <Button Content="Image…" Style="{StaticResource MiniButtonStyle}" Click="SetPoemImageButton_OnClick" FontSize="11" Margin="0,0,4,0"/>
                                    <Button x:Name="RemovePoemImageButton" Content="✕" Style="{StaticResource MiniButtonStyle}" Click="RemovePoemImageButton_OnClick"
                                            FontSize="11" Visibility="Collapsed" Margin="0,0,12,0"/>
                                    <Button x:Name="DeletePoemButton" Content="Supprimer le poème" Style="{StaticResource MiniButtonStyle}" Click="DeletePoemButton_OnClick" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- poe8 has no "back to the book" control: the poem list stays on screen at the left, so
                             returning to the book means clicking another poem there, and returning to the shelf
                             means "← Bibliothèque" in the header. The control is kept (other paths still route to
                             it) but folded away, so the page reads like the mockup. -->
                        <Button x:Name="PoemEditorBackButton" Content="◀ Retour au recueil" Style="{StaticResource SecondaryButtonStyle}"
                                Click="PoemEditorBackButton_OnClick" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Visibility="Collapsed" ToolTip="Retour au recueil"/>
                    </Grid>
                </Grid>

                <!-- Recueil management fly-out, opened by the ⋯ button on the book header. Declared last so it
                     paints over the stage. It re-homes everything the dissolved rail used to hold — the recueil
                     filter list, renaming, deletion and the "new recueil" form — so no capability is lost to the
                     redesign; it is simply folded behind one control instead of standing in a permanent column. -->
                <Border x:Name="PoetryMenuScrim" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="#6604060F" Visibility="Collapsed">
                    <Border x:Name="PoetryRailMenu" Style="{StaticResource CardBorderStyle}" Background="{StaticResource AppBgBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}" Width="330" MaxHeight="560"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,72,26,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="RECUEILS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,12"/>

                            <!-- No create form here any longer: creating a recueil belongs on the shelf, beside the
                                 covers it produces. Two entrances to the same action only made the fly-out read as the
                                 place where creating lived, and it was the thing you could not leave with Escape. -->

                            <TextBlock Text="Filtrer" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                            <ListBox x:Name="RecueilFilterList" Background="Transparent" Foreground="{StaticResource TextBrush}"
                                     BorderThickness="0" MaxHeight="190" Margin="0,0,0,10"
                                     SelectionChanged="RecueilFilterList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Rectangle Height="1" Margin="0,6,0,10" Fill="{StaticResource AppBorderBrush}"/>

                            <!-- The recueil currently open as a book: renamed, summarised and deleted from here.
                                 poe8 keeps the header bare, so the book's own controls live behind ⋯ along with
                                 the rest of the recueil management. -->
                            <TextBlock Text="CE RECUEIL OUVERT" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                            <StackPanel x:Name="BookManagePanel" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="BookRenameInput" Style="{StaticResource DarkTextBoxStyle}" Width="150" Margin="0,0,6,0"
                                             LostFocus="BookRenameInput_OnLostFocus"/>
                                    <Button Content="Renommer" Style="{StaticResource MiniButtonStyle}" Click="BookRenameButton_OnClick"/>
                                </StackPanel>
                                <TextBox x:Name="BookSummaryInput" Style="{StaticResource DarkTextBoxStyle}" Height="56" Margin="0,0,0,8"
                                         TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Georgia" FontSize="12" FontStyle="Italic"
                                         Foreground="{StaticResource TextBrush}" Padding="10,6"
                                         ToolTip="Résumé du recueil" LostFocus="BookSummaryInput_OnLostFocus"/>
                                <Button x:Name="BookDeleteButton" Content="Supprimer le recueil" Style="{StaticResource MiniButtonStyle}"
                                        HorizontalAlignment="Left" Click="BookDeleteButton_OnClick" ToolTip="Supprimer le recueil"/>
                            </StackPanel>

                            <Rectangle Height="1" Margin="0,14,0,10" Fill="{StaticResource AppBorderBrush}"/>
                            <Button x:Name="RecueilBookshelfButton" Content="Vue de l'étagère" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RecueilBookshelfButton_OnClick" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- Archive artistique: free-form canvas linking Observations into projects -->
            <Grid x:Name="ArtisticJournalRoot" Visibility="Collapsed">
                <!-- Project list: the artistic projects that live on their own free-form canvas -->
                <Border x:Name="ProjectListRoot" Style="{StaticResource CardBorderStyle}" Padding="16" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ARCHIVE ARTISTIQUE" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox x:Name="NewProjectTitleInput" Style="{StaticResource DarkTextBoxStyle}" Width="220" Margin="0,0,8,0"/>
                            <Button Content="Nouveau projet" Style="{StaticResource SecondaryButtonStyle}" Click="NewProjectButton_OnClick"/>
                        </StackPanel>

                        <ListBox Grid.Row="2" x:Name="ProjectsList" DisplayMemberPath="Title"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 SelectionChanged="ProjectsList_OnSelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Canvas: free-form, pannable surface for one artistic project -->
                <Grid x:Name="CanvasRoot" Visibility="Collapsed" Focusable="True" PreviewKeyDown="CanvasRoot_OnPreviewKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="← Retour" Style="{StaticResource SecondaryButtonStyle}" Click="BackToProjectsButton_OnClick" Margin="0,0,12,4"/>
                        <TextBlock x:Name="CanvasProjectTitleText" Foreground="{StaticResource TextBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,16,4"/>
                        <Button Content="Ajouter texte" Style="{StaticResource SecondaryButtonStyle}" Click="AddTextNoteButton_OnClick" Margin="0,0,4,4"/>
                        <Button Content="Ajouter image" Style="{StaticResource SecondaryButtonStyle}" Click="AddImageButton_OnClick" Margin="0,0,4,4"/>
                        <Button Content="Ajouter référence" Style="{StaticResource SecondaryButtonStyle}" Click="AddReferenceButton_OnClick" Margin="0,0,4,4"/>
                        <Button x:Name="DrawArrowButton" Content="Tracer une flèche" Style="{StaticResource SecondaryButtonStyle}" Click="DrawArrowButton_OnClick" Margin="0,0,16,4"/>
                        <Button Content="Annuler" Style="{StaticResource MiniButtonStyle}" Click="UndoButton_OnClick" Margin="0,0,4,4"/>
                        <Button Content="Rétablir" Style="{StaticResource MiniButtonStyle}" Click="RedoButton_OnClick" Margin="0,0,4,4"/>
                    </WrapPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" PreviewMouseWheel="CanvasScrollViewer_OnPreviewMouseWheel">
                            <Canvas x:Name="ElementCanvas" Width="3000" Height="3000" Background="{StaticResource CanvasGridBrush}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Observation picker: pick which Observation a new "reference" element should point to -->
            <Border x:Name="ReferencePickerOverlay" Background="Transparent" Visibility="Collapsed" Focusable="True"
                    PreviewKeyDown="ReferencePickerOverlay_OnPreviewKeyDown">
                <Grid>
                    <Border Background="{StaticResource OverlayBrush}"/>
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            Padding="16" Width="360" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="PICK AN OBSERVATION" Style="{StaticResource PanelSectionHeaderStyle}" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" x:Name="ObservationPickerList" DisplayMemberPath="Label"
                                     Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                     SelectionChanged="ObservationPickerList_OnSelectionChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
