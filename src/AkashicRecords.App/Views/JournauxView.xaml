<UserControl x:Class="AkashicRecords.App.Views.JournauxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Each journal type has its own philosophy/UI per the spec - this switches between them -->
        <Border Grid.Row="0" HorizontalAlignment="Left" Margin="0,0,0,16" Background="{StaticResource Surface1Brush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="PersonalJournalTab" Content="Journal personnel" Tag="Personal" IsChecked="True"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
                <ToggleButton x:Name="RecipesJournalTab" Content="Journal de recettes" Tag="Recipes"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
                <ToggleButton x:Name="PoetryJournalTab" Content="Recueil de poésie" Tag="Poetry"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
                <ToggleButton x:Name="ArtisticJournalTab" Content="Archive artistique" Tag="Artistic"
                              Style="{StaticResource NavButtonStyle}" Click="JournalTypeTab_OnClick"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <!-- Journal personnel: a calendar (chips mark days with an entry) + a book you page through,
                 one page per entry, in chronological order - opens on today so you can write immediately -->
            <Grid x:Name="PersonalJournalRoot">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="300" Style="{StaticResource CardBorderStyle}" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}" Padding="16" Margin="0,0,20,0" VerticalAlignment="Stretch">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Bottom" Content="＋ Aujourd'hui" Style="{StaticResource PrimaryPillButtonStyle}"
                                HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="GoToTodayButton_OnClick"/>
                        <Grid>
                            <Calendar x:Name="EntryCalendar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="13"
                                      SelectedDatesChanged="EntryCalendar_OnSelectedDatesChanged"
                                      CalendarDayButtonStyle="{StaticResource EntryDayButtonStyle}"
                                      Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderStrongBrush}" Padding="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="‹" Click="PreviousEntryButton_OnClick" Width="30" Height="30"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontSize="18"/>
                                <Button Content="›" Click="NextEntryButton_OnClick" Width="30" Height="30"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontSize="18"/>
                            </StackPanel>
                            <TextBox x:Name="EntryTitleInput" LostFocus="EntryTitleInput_OnLostFocus"
                                     FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                     Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource AppBorderBrush}"
                                     Padding="0,4" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Grid.Row="1" x:Name="PageDateText" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,6,0,16"/>

                        <TextBox Grid.Row="2" x:Name="EntryTextInput" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" FontSize="15"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,14" LostFocus="EntryTextInput_OnLostFocus"/>

                        <StackPanel Grid.Row="3" Margin="0,0,0,16">
                            <TextBlock Text="Tags (séparés par des virgules)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="EntryTagsInput" Style="{StaticResource DarkTextBoxStyle}" LostFocus="EntryTagsInput_OnLostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="PHOTOS" Style="{StaticResource PanelSectionHeaderStyle}" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="EntryPhotosPanel" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Ajouter une photo…" Style="{StaticResource SecondaryButtonStyle}" Click="AddEntryPhotoButton_OnClick"/>
                                <Button x:Name="DeleteEntryButton" Content="Supprimer cette entrée" Style="{StaticResource MiniButtonStyle}" Click="DeleteEntryButton_OnClick" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Journal de recettes: a personal recipe book (sidebar list + one recipe "page" at a time),
                 not a food-management system - filter by category chip, search, or ingredient text -->
            <Grid x:Name="RecipesRoot" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,20,0">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="JOURNAL DE RECETTES" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                        <TextBox Grid.Row="1" x:Name="RecipeSearchInput" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,10"
                                 TextChanged="RecipeSearchInput_OnTextChanged"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox x:Name="NewRecipeTitleInput" Style="{StaticResource DarkTextBoxStyle}" Width="130" Margin="0,0,8,0"/>
                            <Button Content="Nouvelle" Style="{StaticResource SecondaryButtonStyle}" Click="NewRecipeButton_OnClick"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="3" x:Name="RecipeCategoryFilterPanel" Margin="0,0,0,10"/>

                        <ListBox Grid.Row="4" x:Name="RecipeTitleList" DisplayMemberPath="Title"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 SelectionChanged="RecipeTitleList_OnSelectionChanged"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Left" Content="◀ Précédent" Style="{StaticResource SecondaryButtonStyle}" Click="PreviousRecipeButton_OnClick"/>
                            <Button DockPanel.Dock="Right" Content="Suivant ▶" Style="{StaticResource SecondaryButtonStyle}" Click="NextRecipeButton_OnClick"/>
                            <TextBlock x:Name="RecipePageTitleText" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                       FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                        </DockPanel>

                        <Image x:Name="RecipeCoverImage" Grid.Row="1" Height="140" Margin="0,0,0,8"
                               Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Choisir une photo…" Style="{StaticResource SecondaryButtonStyle}" Click="SetRecipeCoverButton_OnClick"/>
                            <Button x:Name="RemoveRecipeCoverButton" Content="Retirer la photo" Style="{StaticResource MiniButtonStyle}" Click="RemoveRecipeCoverButton_OnClick"
                                    Margin="12,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Titre" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="RecipeTitleInput" Style="{StaticResource DarkTextBoxStyle}" Width="220" LostFocus="RecipeField_OnLostFocus"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Catégorie" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="RecipeCategoryInput" Style="{StaticResource DarkTextBoxStyle}" Width="160" LostFocus="RecipeField_OnLostFocus"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Margin="0,0,0,12">
                            <TextBlock Text="Ingrédients" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeIngredientsInput" Style="{StaticResource DarkTextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                     LostFocus="RecipeField_OnLostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Margin="0,0,0,12">
                            <TextBlock Text="Préparation" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeInstructionsInput" Style="{StaticResource DarkTextBoxStyle}" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                     LostFocus="RecipeField_OnLostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Margin="0,0,0,12">
                            <TextBlock Text="Notes personnelles" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeNotesInput" Style="{StaticResource DarkTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                     LostFocus="RecipeField_OnLostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Margin="0,0,0,12">
                            <TextBlock Text="Tags (séparés par des virgules)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="RecipeTagsInput" Style="{StaticResource DarkTextBoxStyle}" LostFocus="RecipeField_OnLostFocus"/>
                        </StackPanel>

                        <Button Grid.Row="8" x:Name="DeleteRecipeButton" Content="Supprimer la recette" Style="{StaticResource MiniButtonStyle}" Click="DeleteRecipeButton_OnClick"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Recueil de poésie: a notebook, not a canvas - poems optionally grouped into recueils -->
            <Grid x:Name="PoetryRoot" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left rail: always-present controls. New poem here, plus a compact recueil picker
                     so the user can jump straight to any anthology. -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,20,0">
                    <DockPanel Width="200">
                        <DockPanel.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                        </DockPanel.Resources>
                        <TextBlock DockPanel.Dock="Top" Text="RECUEIL DE POÉSIE" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                        <TextBox DockPanel.Dock="Top" x:Name="PoemSearchInput" Style="{StaticResource DarkTextBoxStyle}" Height="32" Margin="0,0,0,10"
                                 TextChanged="PoemSearchInput_OnTextChanged"/>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="NewPoemTitleInput" Style="{StaticResource DarkTextBoxStyle}" Width="110" Margin="0,0,6,0"/>
                            <Button Content="+ Poème" Style="{StaticResource SecondaryButtonStyle}" Click="NewPoemButton_OnClick" ToolTip="Nouveau poème (dans le recueil sélectionné, ou « Sans recueil »)"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="NewRecueilTitleInput" Style="{StaticResource DarkTextBoxStyle}" Width="100" Margin="0,0,6,0"/>
                            <Button Content="+ Recueil" Style="{StaticResource SecondaryButtonStyle}" Click="NewRecueilButton_OnClick"/>

                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="Recueils" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,4"/>
                        <ListBox x:Name="RecueilFilterList" DockPanel.Dock="Top"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 MaxHeight="150"
                                 SelectionChanged="RecueilFilterList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Recueil rename/delete: only shown while a real recueil is selected -->
                        <StackPanel DockPanel.Dock="Top" x:Name="RecueilManagePanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBox x:Name="RecueilRenameInput" Style="{StaticResource DarkTextBoxStyle}" Width="80"
                                     LostFocus="RecueilRenameInput_OnLostFocus"/>
                            <Button Content="Rename" Style="{StaticResource MiniButtonStyle}" Click="RecueilRenameButton_OnClick" Margin="4,0,2,0"/>
                            <Button x:Name="RecueilDeleteButton" Content="✕" Style="{StaticResource MiniButtonStyle}" Width="26"
                                    Click="RecueilDeleteButton_OnClick"/>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="Vue rapide" Style="{StaticResource FieldLabelStyle}" Margin="0,16,0,4"/>
                        <Button DockPanel.Dock="Top" x:Name="RecueilBookshelfButton" Content="📚 Étagère" Style="{StaticResource SecondaryButtonStyle}"
                                Click="RecueilBookshelfButton_OnClick" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                    </DockPanel>
                </Border>

                <!-- The main stage: either the bookshelf (covers) or the open book (recueil + poems). -->
                <Grid Grid.Column="1">
                    <!-- BOOKSHELF: horizontal scroll of recueil covers. -->
                    <Grid x:Name="PoetryBookshelf">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" x:Name="BookshelfTitle" Text="Mes recueils" FontSize="20"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock DockPanel.Dock="Right" x:Name="BookshelfCount" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      Padding="0,8,0,16" MouseWheel="BookshelfScrollViewer_MouseWheel">
                            <ItemsControl x:Name="RecueilCoverList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A cover: a standing card with the recueil title, a little poem count,
                                             and a colored spine. Clicking it opens the book. -->
                                        <Border Width="150" Margin="0,0,24,0" Cursor="Hand" MouseLeftButtonUp="RecueilCover_OnClick">
                                            <Border Background="{Binding CoverBrush}" CornerRadius="8"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1"
                                                    Padding="12" VerticalAlignment="Top" Height="180">
                                                <Border.Child>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="White"
                                                                   FontFamily="Georgia" FontSize="15" FontWeight="Bold"
                                                                   TextWrapping="Wrap" VerticalAlignment="Bottom"
                                                                   MaxHeight="90"/>
                                                        <TextBlock Grid.Row="1" Margin="0,20,0,0" Text="{Binding PoemCountText}"
                                                                   Foreground="#CCFFFFFF" FontSize="11"/>
                                                        <TextBlock Grid.Row="2" Margin="0,2,0,0" Text="Ouvrir ▸"
                                                                   Foreground="#99FFFFFF" FontSize="10"/>
                                                    </Grid>
                                                </Border.Child>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- OPEN BOOK: the selected recueil's summary + its poems. -->
                    <Grid x:Name="PoetryBook" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Book header: back button + recueil title + rename/delete. -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Left" Content="◀ Retour" x:Name="BookshelfBackButton" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BookshelfBackButton_OnClick" Margin="0,0,12,0"
                                    ToolTip="Retour à l'étagère"/>
                            <TextBlock DockPanel.Dock="Left" x:Name="BookTitle" Text="" FontSize="22"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox x:Name="BookRenameInput" Style="{StaticResource DarkTextBoxStyle}" Width="140" Margin="0,0,6,0"
                                         LostFocus="BookRenameInput_OnLostFocus"/>
                                <Button Content="Renommer" Style="{StaticResource MiniButtonStyle}" Click="BookRenameButton_OnClick" Margin="0,0,4,0"/>
                                <Button x:Name="BookDeleteButton" Content="✕" Style="{StaticResource MiniButtonStyle}" Width="30"
                                        Click="BookDeleteButton_OnClick" ToolTip="Supprimer le recueil"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Summary: a short description of the recueil. -->
                        <TextBox x:Name="BookSummaryInput" Grid.Row="1" Height="48" Margin="0,0,0,16"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Georgia" FontSize="13" FontStyle="Italic"
                                 Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                 Foreground="{StaticResource TextBrush}" Padding="10,6" LostFocus="BookSummaryInput_OnLostFocus"/>

                        <!-- Poems in this recueil, shown as a vertical list of cards. -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="PoemCardList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A poem card: title, a preview of the text, and a click-to-open affordance. -->
                                        <Border Width="280" Margin="0,0,20,16" Cursor="Hand"
                                                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="16"
                                                MouseLeftButtonUp="PoemCard_OnClick">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                                           FontFamily="Georgia" FontSize="16" FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="{StaticResource TextMutedBrush}"
                                                           FontFamily="Georgia" FontSize="12" TextWrapping="Wrap"
                                                       MaxHeight="120" Text="{Binding Preview}"/>
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                                    <TextBlock Text="Ouvrir ▸" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                    <TextBlock Text="  •  " Foreground="{StaticResource TextFaintBrush}"/>
                                                    <TextBlock Text="{Binding PoemCountText}" Foreground="{StaticResource TextFaintBrush}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- POEM EDITOR: the open poem page. A notebook page, styled like verse. -->
                    <Grid x:Name="PoemEditor" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: the poem page itself. -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="24" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,20,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Paging: jump to the previous/next poem in the current recueil. -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Left" Content="◀ Préc." Click="PreviousPoemButton_OnClick"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"/>
                                    <Button DockPanel.Dock="Right" Content="Suiv. ▶" Click="NextPoemButton_OnClick"
                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"/>
                                    <TextBlock HorizontalAlignment="Center"/>
                                </DockPanel>

                                <!-- Title, as a heading. -->
                                <TextBox Grid.Row="1" x:Name="PoemTitleInput" LostFocus="PoemField_OnLostFocus"
                                         FontFamily="Georgia" FontSize="26" FontWeight="Bold" TextAlignment="Center"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                         TextWrapping="Wrap" Margin="0,0,0,4"/>

                                <Image x:Name="PoemImage" Grid.Row="2" MaxHeight="180" Margin="0,4,0,12"
                                       Stretch="Uniform" HorizontalAlignment="Center" Visibility="Collapsed"/>

                                <!-- Formatting toolbar. -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                    <ToggleButton x:Name="PoemAlignLeftButton" Content="⯇≡" Tag="Left" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,2,0"/>
                                    <ToggleButton x:Name="PoemAlignCenterButton" Content="≡" Tag="Center" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,2,0"/>
                                    <ToggleButton x:Name="PoemAlignRightButton" Content="≡⯈" Tag="Right" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,2,0"/>
                                    <ToggleButton x:Name="PoemAlignJustifyButton" Content="☰" Tag="Justify" Click="PoemAlignButton_OnClick"
                                                  Style="{StaticResource NavButtonStyle}" Padding="6,2" Margin="0,0,16,0"/>
                                    <TextBlock Text="Marges" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="−" Style="{StaticResource MiniButtonStyle}" Click="PoemMarginDecreaseButton_OnClick" Padding="8,2" Margin="0,0,2,0"/>
                                    <Button Content="+" Style="{StaticResource MiniButtonStyle}" Click="PoemMarginIncreaseButton_OnClick" Padding="8,2"/>
                                </StackPanel>

                                <!-- The poem text. -->
                                <TextBox Grid.Row="4" x:Name="PoemTextInput" TextWrapping="Wrap" AcceptsReturn="True"
                                         FontStyle="Italic" FontFamily="Georgia" FontSize="19"
                                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                         MinHeight="200" MaxHeight="360"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         LostFocus="PoemField_OnLostFocus"/>

                                <!-- Organizational row. -->
                                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Recueil" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="PoemRecueilPicker" Style="{StaticResource DarkComboBoxStyle}" Width="150" DisplayMemberPath="Title" FontSize="11"
                                              SelectionChanged="PoemRecueilPicker_OnSelectionChanged" Margin="0,0,12,0"/>
                                    <TextBlock Text="Tags" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="PoemTagsInput" Style="{StaticResource DarkTextBoxStyle}" Width="160" FontSize="11" LostFocus="PoemField_OnLostFocus" Margin="0,0,12,0"/>
                                    <Button Content="Image…" Style="{StaticResource MiniButtonStyle}" Click="SetPoemImageButton_OnClick" FontSize="11" Margin="0,0,4,0"/>
                                    <Button x:Name="RemovePoemImageButton" Content="✕" Style="{StaticResource MiniButtonStyle}" Click="RemovePoemImageButton_OnClick"
                                            FontSize="11" Visibility="Collapsed" Margin="0,0,12,0"/>
                                    <Button x:Name="DeletePoemButton" Content="Supprimer le poème" Style="{StaticResource MiniButtonStyle}" Click="DeletePoemButton_OnClick" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right: a slim back button to return to the book. -->
                        <Button Grid.Column="1" Content="◀ Retour au recueil" x:Name="PoemEditorBackButton" Style="{StaticResource SecondaryButtonStyle}"
                                Click="PoemEditorBackButton_OnClick" VerticalAlignment="Top"
                                ToolTip="Retour au recueil"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Archive artistique: free-form canvas linking Observations into projects -->
            <Grid x:Name="ArtisticJournalRoot" Visibility="Collapsed">
                <!-- Project list: the artistic projects that live on their own free-form canvas -->
                <Border x:Name="ProjectListRoot" Style="{StaticResource CardBorderStyle}" Padding="16" MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid>
                        <Grid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ARCHIVE ARTISTIQUE" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox x:Name="NewProjectTitleInput" Style="{StaticResource DarkTextBoxStyle}" Width="220" Margin="0,0,8,0"/>
                            <Button Content="Nouveau projet" Style="{StaticResource SecondaryButtonStyle}" Click="NewProjectButton_OnClick"/>
                        </StackPanel>

                        <ListBox Grid.Row="2" x:Name="ProjectsList" DisplayMemberPath="Title"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 SelectionChanged="ProjectsList_OnSelectionChanged"/>
                    </Grid>
                </Border>

                <!-- Canvas: free-form, pannable surface for one artistic project -->
                <Grid x:Name="CanvasRoot" Visibility="Collapsed" Focusable="True" PreviewKeyDown="CanvasRoot_OnPreviewKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <Button Content="← Retour" Style="{StaticResource SecondaryButtonStyle}" Click="BackToProjectsButton_OnClick" Margin="0,0,12,4"/>
                        <TextBlock x:Name="CanvasProjectTitleText" Foreground="{StaticResource TextBrush}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,16,4"/>
                        <Button Content="Ajouter texte" Style="{StaticResource SecondaryButtonStyle}" Click="AddTextNoteButton_OnClick" Margin="0,0,4,4"/>
                        <Button Content="Ajouter image" Style="{StaticResource SecondaryButtonStyle}" Click="AddImageButton_OnClick" Margin="0,0,4,4"/>
                        <Button Content="Ajouter référence" Style="{StaticResource SecondaryButtonStyle}" Click="AddReferenceButton_OnClick" Margin="0,0,4,4"/>
                        <Button x:Name="DrawArrowButton" Content="Tracer une flèche" Style="{StaticResource SecondaryButtonStyle}" Click="DrawArrowButton_OnClick" Margin="0,0,16,4"/>
                        <Button Content="Annuler" Style="{StaticResource MiniButtonStyle}" Click="UndoButton_OnClick" Margin="0,0,4,4"/>
                        <Button Content="Rétablir" Style="{StaticResource MiniButtonStyle}" Click="RedoButton_OnClick" Margin="0,0,4,4"/>
                    </WrapPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" PreviewMouseWheel="CanvasScrollViewer_OnPreviewMouseWheel">
                            <Canvas x:Name="ElementCanvas" Width="3000" Height="3000" Background="{StaticResource CanvasGridBrush}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Observation picker: pick which Observation a new "reference" element should point to -->
            <Border x:Name="ReferencePickerOverlay" Background="Transparent" Visibility="Collapsed" Focusable="True"
                    PreviewKeyDown="ReferencePickerOverlay_OnPreviewKeyDown">
                <Grid>
                    <Border Background="{StaticResource OverlayBrush}"/>
                    <Border Style="{StaticResource CardBorderStyle}" Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            Padding="16" Width="360" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="PICK AN OBSERVATION" Style="{StaticResource PanelSectionHeaderStyle}" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" x:Name="ObservationPickerList" DisplayMemberPath="Label"
                                     Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                     SelectionChanged="ObservationPickerList_OnSelectionChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
