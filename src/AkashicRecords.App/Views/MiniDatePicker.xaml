<UserControl x:Class="AkashicRecords.App.Views.MiniDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="150">
    <!-- Drop-in replacement for DatePicker in dark panels. The WPF Calendar popup can't be
         re-themed without cloning its whole CalendarItem template, so the picker is built from
         the same primitives as the section's month grid: a chip + a popup of hand-built day
         cells. The chip lives in the normal tree (not a ControlTemplate) so its TextBlocks are
         real fields — names inside a template never become code-behind fields. -->
    <Grid>
        <Border x:Name="Chip" Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="9,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Watermark" Text="Sélectionner une date" Foreground="#888888"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBlock x:Name="Label" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="📅" FontSize="12" Margin="6,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <!-- Transparent toggle on top: owns the open/close state and the hover/checked ring,
             without reimplementing the chip as a template. -->
        <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Cursor="Hand"
                      Checked="Toggle_OnChecked" Unchecked="Toggle_OnUnchecked">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Ring" Background="Transparent" CornerRadius="8"
                            BorderBrush="Transparent" BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" Focusable="False"
               AllowsTransparency="True" PopupAnimation="Fade"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}">
            <Border Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="‹" Width="24" Height="22" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" FontSize="14"
                                Foreground="{StaticResource TextMutedBrush}" Click="Prev_OnClick"/>
                        <TextBlock x:Name="MonthText" Grid.Column="1" TextAlignment="Center"
                                   FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Button Grid.Column="2" Content="›" Width="24" Height="22" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" FontSize="14"
                                Foreground="{StaticResource TextMutedBrush}" Click="Next_OnClick"/>
                    </Grid>
                    <UniformGrid Columns="7" Margin="0,0,0,2">
                        <TextBlock Text="L" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock Text="M" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock Text="M" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock Text="J" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock Text="V" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock Text="S" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"/>
                        <TextBlock Text="D" TextAlignment="Center" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextFaintBrush}"/>
                    </UniformGrid>
                    <UniformGrid x:Name="DayGrid" Rows="6" Columns="7"/>
                    <Button Content="Aujourd'hui" HorizontalAlignment="Center" Margin="0,6,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="Today_OnClick"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
