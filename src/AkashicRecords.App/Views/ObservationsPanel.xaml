<UserControl x:Class="AkashicRecords.App.Views.ObservationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Observations of one item (any kind), with their links to artistic projects. Hosted by every
         page that shows an item: Collections fiche, journal entry, poem, recipe, photo, reference image, track. -->
    <StackPanel>
        <DockPanel>
            <Button x:Name="FoldButton" DockPanel.Dock="Right" Content="▾" Click="FoldButton_OnClick"
                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,0"
                    Foreground="{StaticResource TextFaintBrush}" ToolTip="Replier / déplier"/>
            <TextBlock x:Name="HeaderText" Text="OBSERVATIONS" Style="{StaticResource PanelSectionHeaderStyle}"/>
        </DockPanel>

        <StackPanel x:Name="Body">
            <!-- Bounded: the app window spans the whole screen, an unbounded list would stretch the page. -->
            <ScrollViewer x:Name="ListScroll" MaxHeight="220" Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ItemsHost"/>
            </ScrollViewer>

            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Sujet (facultatif)" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="SubjectInput" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="Observation" Style="{StaticResource FieldLabelStyle}"/>
                <TextBox x:Name="ContentInput" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkTextBoxStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SaveButton" Content="＋ Ajouter l'observation" Click="SaveButton_OnClick"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button x:Name="CancelEditButton" Content="Annuler" Click="CancelEditButton_OnClick"
                            Margin="8,0,0,0" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
