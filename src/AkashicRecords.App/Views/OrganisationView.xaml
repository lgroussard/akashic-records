<UserControl x:Class="AkashicRecords.App.Views.OrganisationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <!-- Organisation view styles (moved from App.xaml so event handlers resolve against OrganisationView) -->

            <!-- Organisation: project list item (title + status pill + progress text + bar) -->
            <DataTemplate x:Key="ProjectItemTemplate">
                <Border Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentBrush}" CornerRadius="6"
                                    Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,0,10,0"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SubText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <Border Margin="0,7,0,0">
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6"
                                       Background="{StaticResource Surface3Brush}" Foreground="{StaticResource AccentGradientBrush}"
                                       BorderThickness="0" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Organisation: transition list item (title + progress text + bar + bell) -->
            <DataTemplate x:Key="TransitionItemTemplate">
                <Border Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,0,10,0"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                        </StackPanel>
                        <Border Margin="0,7,0,0">
                            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6"
                                       Background="{StaticResource Surface3Brush}" Foreground="{StaticResource AccentGradientBrush}"
                                       BorderThickness="0" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Organisation: project task row (checkbox + label + remove) -->
            <DataTemplate x:Key="ProjectTaskTemplate">
                <Border Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="12,10"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" Tag="{Binding Id}" IsChecked="{Binding IsDone}"
                                  VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"
                                  Click="TaskCheck_OnClick"/>
                        <TextBox Tag="{Binding Id}" Text="{Binding Text}" Background="Transparent"
                                 Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="0,0,8,0"
                                 VerticalAlignment="Center" LostFocus="TaskText_OnLostFocus"/>
                        <Button DockPanel.Dock="Right" Content="×" Tag="{Binding Id}" ToolTip="Retirer la tache"
                                Click="DeleteTaskButton_OnClick"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextFaintBrush}"
                                Cursor="Hand" FontSize="14"/>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- Organisation: transition step row (numbered circle + label + remove) -->
            <DataTemplate x:Key="TransitionStepTemplate">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Left" Tag="{Binding Id}" IsChecked="{Binding IsDone}"
                              VerticalAlignment="Center" Cursor="Hand" Click="StepCheck_OnClick">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Width" Value="28"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="MinWidth" Value="28"/>
                                <Setter Property="MinHeight" Value="28"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid>
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                        CornerRadius="999" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <Border Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="0">
                        <DockPanel>
                            <TextBox Tag="{Binding Id}" Text="{Binding Text}" Background="Transparent"
                                     Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="0,0,8,0"
                                     VerticalAlignment="Center" LostFocus="StepText_OnLostFocus"/>
                            <Button DockPanel.Dock="Right" Content="×" Tag="{Binding Id}" ToolTip="Retirer l'etape"
                                    Click="DeleteStepButton_OnClick"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextFaintBrush}"
                                    Cursor="Hand" FontSize="14"/>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </DataTemplate>

            <!-- Organisation: add-task row (dashed, transparent) -->
            <DataTemplate x:Key="AddTaskTemplate">
                <Border Background="Transparent" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="+" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0"
                                 Padding="0" VerticalAlignment="Center" Text="Ajouter une tâche"
                                 GotFocus="AddTaskPlaceholder_OnGotFocus" LostFocus="AddTaskPlaceholder_OnLostFocus"/>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- Organisation: transition state box (DEPUIS / VERS) -->
            <DataTemplate x:Key="TransitionStateTemplate">
                <Border Background="{StaticResource Surface3Brush}"
                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource OrgSectionHeaderStyle}"/>
                        <TextBox Text="{Binding Value}" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                 Padding="0" Height="44" VerticalAlignment="Center"
                                 LostFocus="TransitionField_OnLostFocus"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Organisation: desktop reminder card (accent-soft) -->
            <DataTemplate x:Key="ReminderTemplate">
                <Border Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="?? RAPPEL BUREAU" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ReminderText}" Foreground="{StaticResource TextBrush}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Organisation: page title input (transparent, bold, 20px) -->
            <Style x:Key="PageTitleInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Organisation: section header (uppercase, letter-spaced) -->
            <Style x:Key="OrgSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section head: title + subtitle -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Organisation" FontSize="22" FontWeight="800"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="Projets et transitions — suivre sans se noyer."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Toolbar: segmented sub-tabs + "＋ Nouveau" CTA -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" HorizontalAlignment="Left" Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="ProjetsTab" Content="Projets" Tag="Projets" IsChecked="True"
                                  Style="{StaticResource NavButtonStyle}" Click="SubTab_OnClick"/>
                    <ToggleButton x:Name="TransitionsTab" Content="Transitions" Tag="Transitions"
                                  Style="{StaticResource NavButtonStyle}" Click="SubTab_OnClick"/>
                </StackPanel>
            </Border>

            <Button x:Name="NewButton" Grid.Column="1" Content="＋ Nouveau" Style="{StaticResource PrimaryPillButtonStyle}"
                    VerticalAlignment="Center" Click="NewItemButton_OnClick"/>
        </Grid>

        <!-- ============ PROJETS board ============ -->
        <Grid x:Name="ProjetsRoot" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Project list -->
            <Border Grid.Column="0" Margin="0,0,16,0" Padding="8"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12">
                <ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemTemplate="{StaticResource ProjectItemTemplate}"
                         SelectionChanged="ProjectList_OnSelectionChanged">
                    <!-- The item Border carries its own surface. The dialect's default ListBoxItem template
                         paints a grey selection slab behind the card (the "grey block" defect), which a Background
                         setter does not reach, so the container is given a transparent template over a bare
                         ContentPresenter, the same escape JournauxView's recipe list already uses. The card keeps
                         its own accent via the IsSelected DataTrigger in its template. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" CornerRadius="10">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Project detail -->
            <Border Grid.Column="1" x:Name="ProjectDetailPanel" Visibility="Collapsed"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                    </Grid.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Title, with the delete action as a quiet red link top-right and the status picker
                                 under the title, exactly as the mockup stages the header. The big full-width
                                 delete button that used to sit at the foot is gone, replaced by this link. -->
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Content="Supprimer" Click="DeleteProjectButton_OnClick"
                                        Background="Transparent" BorderThickness="0" Foreground="#FFE0607A"
                                        Cursor="Hand" FontSize="13" VerticalAlignment="Center"
                                        ToolTip="Supprimer ce projet"/>
                                <TextBox x:Name="ProjectTitleInput" Style="{StaticResource PageTitleInputStyle}"
                                         LostFocus="ProjectField_OnLostFocus"/>
                            </DockPanel>

                            <!-- Description, labelled like the mockup (an unnamed box read as dead space). Uppercased to match the mockup's field label. -->
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="ProjectDescriptionInput" Style="{StaticResource DarkTextBoxStyle}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64"
                                     LostFocus="ProjectField_OnLostFocus" Margin="0,4,0,14"/>

                            <!-- Statut + Echeance side by side, each with its label above, as the mockup pairs them.
                                 The deadline picker carries its own "Selectionner une date" placeholder, so the old
                                 centered "Echeance a definir" watermark is dropped (the two stacked into one
                                 overprinted jumble), and the label is the only text telling the empty state. -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Statut" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox x:Name="ProjectStatusInput" Width="140" Margin="0,4,0,0"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  SelectionChanged="ProjectStatusInput_OnSelectionChanged">
                                            <ComboBoxItem Content="Actif"/>
                                            <ComboBoxItem Content="Terminé"/>
                                            <ComboBoxItem Content="Archivé"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Échéance (optionnelle)" Style="{StaticResource FieldLabelStyle}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <DatePicker x:Name="ProjectDeadlineInput" Style="{StaticResource DarkDatePickerStyle}"
                                                        SelectedDateChanged="ProjectDeadlineInput_OnSelectedDateChanged"/>
                                            <Button x:Name="ClearDeadlineButton" Content="✕" ToolTip="Retirer l'échéance"
                                                    Click="ClearProjectDeadlineButton_OnClick"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                                    Cursor="Hand" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Tasks -->
                            <TextBlock Text="TÂCHES" Style="{StaticResource OrgSectionHeaderStyle}"/>
                            <ItemsControl x:Name="TaskList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProjectTaskTemplate}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- One add affordance, not two: the dashed empty box (AddTaskRow) mirrored the real
                                 input below it and only added a dead, non-editable row. -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBox x:Name="NewTaskInput" Width="220" Margin="0,0,8,0" Style="{StaticResource DarkTextBoxStyle}"
                                         TextChanged="NewTaskInput_TextChanged"/>
                                <Button Content="＋ Ajouter une tâche" Click="AddTaskButton_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Empty state -->
            <Border x:Name="ProjectEmptyState" Visibility="Collapsed" Background="Transparent">
                <TextBlock x:Name="ProjectEmptyStateText" Text="" Foreground="{StaticResource TextFaintBrush}" FontSize="14"
                           TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
            </Border>
        </Grid>

        <!-- ============ TRANSITIONS board ============ -->
        <Grid x:Name="TransitionsRoot" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Transition list -->
            <Border Grid.Column="0" Margin="0,0,16,0" Padding="8"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12">
                <ListBox x:Name="TransitionListBox" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemTemplate="{StaticResource TransitionItemTemplate}"
                         SelectionChanged="TransitionListBox_OnSelectionChanged">
                    <!-- Same transparent container template as the project list: no grey system slab behind the card. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" CornerRadius="10">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Transition detail -->
            <Border Grid.Column="1" x:Name="TransitionDetailPanel" Visibility="Collapsed"
                    Background="{StaticResource Surface1Brush}"
                    BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinVerticalScrollBarStyle}"/>
                    </Grid.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Title with the delete action as a quiet red link top-right (the foot's full-width
                                 delete button is gone), mirroring the project header. -->
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="Supprimer" Click="DeleteTransitionButton_OnClick"
                                        Background="Transparent" BorderThickness="0" Foreground="#FFE0607A"
                                        Cursor="Hand" FontSize="13" VerticalAlignment="Center"
                                        ToolTip="Supprimer cette transition"/>
                                <TextBox x:Name="TransitionTitleInput" Style="{StaticResource PageTitleInputStyle}"
                                         LostFocus="TransitionField_OnLostFocus"/>
                            </DockPanel>

                            <!-- Description, named so the box is not read as empty dead space. Uppercased to match the mockup's field label. -->
                            <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TransitionDescriptionInput" Style="{StaticResource DarkTextBoxStyle}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                     LostFocus="TransitionField_OnLostFocus" Margin="0,4,0,14"/>

                            <!-- From -> To -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Surface3Brush}"
                                        BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="DEPUIS" Style="{StaticResource OrgSectionHeaderStyle}"/>
                                        <TextBox x:Name="TransitionCurrentStateInput" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                                 Padding="0" Height="44" VerticalAlignment="Center"
                                                 LostFocus="TransitionField_OnLostFocus"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource AccentBrush}"
                                           FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0"/>
                                <Border Grid.Column="2" Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="VERS" Style="{StaticResource OrgSectionHeaderStyle}"/>
                                        <TextBox x:Name="TransitionDesiredStateInput" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                                 Padding="0" Height="44" VerticalAlignment="Center"
                                                 LostFocus="TransitionField_OnLostFocus"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Notes, named; uppercased to match the mockup's field label. -->
                            <TextBlock Text="NOTES" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TransitionNotesInput" Style="{StaticResource DarkTextBoxStyle}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                     LostFocus="TransitionField_OnLostFocus" Margin="0,4,0,14"/>

                            <!-- Resources, named; uppercased to match the mockup's field label. -->
                            <TextBlock Text="RESSOURCES" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="TransitionResourcesInput" Style="{StaticResource DarkTextBoxStyle}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                     LostFocus="TransitionField_OnLostFocus" Margin="0,4,0,14"/>

                            <!-- Progress -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="ÉTAPES PROGRESSIVES" Style="{StaticResource OrgSectionHeaderStyle}"/>
                                <Border>
                                    <ProgressBar x:Name="TransitionProgressBar" Maximum="100" Height="8"
                                                 Background="{StaticResource Surface3Brush}" Foreground="{StaticResource AccentGradientBrush}"
                                                 BorderThickness="0" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="TransitionProgressText" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Steps -->
                            <ItemsControl x:Name="StepList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TransitionStepTemplate}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBox x:Name="NewStepInput" Width="220" Margin="0,0,8,0" Style="{StaticResource DarkTextBoxStyle}"/>
                                <Button Content="＋ Ajouter une étape" Click="AddStepButton_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>

                            <!-- Desktop reminder. The emoji run rendered as tofu in this font, so the header is
                                 plain caps text; the free-text field is labelled instead of a bare transparent box. -->
                            <Border x:Name="ReminderCard" Background="{StaticResource AccentSoftBrush}"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="RAPPEL SUR LE BUREAU" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ShowOnDesktopInput" Content="Afficher un rappel sur le bureau"
                                              Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                                              Margin="0,0,0,10" Click="ShowOnDesktopInput_OnClick"/>
                                    <TextBlock Text="Texte du rappel" Style="{StaticResource FieldLabelStyle}"/>
                                    <Border Background="{StaticResource Surface3Brush}" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                                        <TextBox x:Name="ReminderTextInput" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                                 Padding="0" Height="40" VerticalAlignment="Center"
                                                 LostFocus="TransitionField_OnLostFocus"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Empty state -->
            <Border x:Name="TransitionEmptyState" Visibility="Collapsed" Background="Transparent">
                <TextBlock x:Name="TransitionEmptyStateText" Text="" Foreground="{StaticResource TextFaintBrush}" FontSize="14"
                           TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>