<Window x:Class="AkashicRecords.App.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Closing="SettingsView_OnClosing">
    <Border Background="#F21A1A2E" BorderBrush="#553B82F6" BorderThickness="1"
            CornerRadius="8" Padding="0" Width="560" Height="560" Margin="0,0,24,0">
        <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="24,20">
                <TextBlock Text="PARAMÈTRES" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Text="Recherche d'images automatiques" FontSize="14" FontWeight="SemiBold"
                           Foreground="#7FB0FF" Margin="0,0,0,12"/>

                <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" LineHeight="18" Margin="0,0,0,4">
                    <Run FontSize="13">Par défaut, l'ajout d'un élément tente de trouver sa couverture sur</Run>
                    <Run FontSize="13">Wikipédia (aucune clé requise). Pour les affiches de films, animation et</Run>
                    <Run FontSize="13">anime, entrez une clé TMDB gratuite. L'application reste entièrement</Run>
                    <Run FontSize="13">fonctionnelle sans clé — c'est une option.</Run>
                </TextBlock>

                <TextBlock Text="Clé TMDB (affiches de films/animation/anime)" Foreground="White" Margin="0,10,0,4"/>
                <TextBox x:Name="TmdbKeyInput" Background="#2A2A45" Foreground="White"
                         BorderThickness="1" BorderBrush="#553B82F6" Padding="8,6" Margin="0,0,0,4"/>

                <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" LineHeight="16" Margin="0,0,0,4">
                    <Run FontSize="12" FontWeight="SemiBold">TMDB :</Run>
                    <LineBreak/>
                    <Run FontSize="12">Gratuit, sans restriction régionale. Créez une clé sur</Run>
                    <Run FontSize="12">www.themoviedb.org (Compte → Paramètres → Clés API → v3). Indispensable</Run>
                    <Run FontSize="12">pour les affiches de films, animations et anime. Les livres</Run>
                    <Run FontSize="12">utilisent Wikipédia (aucune clé).</Run>
                </TextBlock>

                <TextBlock Text="Clé RAWG (affiches de jeux vidéo)" Foreground="White" Margin="0,10,0,4"/>
                <TextBox x:Name="RawgKeyInput" Background="#2A2A45" Foreground="White"
                         BorderThickness="1" BorderBrush="#553B82F6" Padding="8,6" Margin="0,0,0,4"/>

                <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" LineHeight="16" Margin="0,0,0,4">
                    <Run FontSize="12" FontWeight="SemiBold">RAWG :</Run>
                    <LineBreak/>
                    <Run FontSize="12">Gratuit, sans restriction régionale. Créez une clé sur</Run>
                    <Run FontSize="12">rawg.io (compte → API). Indispensable pour les affiches de jeux</Run>
                    <Run FontSize="12">vidéo. Sans clé, Wikipédia est utilisée en secours.</Run>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                    <Button x:Name="SaveButton" Content="Enregistrer"
                            Style="{StaticResource ChipButtonStyle}" Padding="16,6" Click="SaveButton_OnClick"/>
                    <Button x:Name="TestTmdbButton" Content="Tester TMDB" Margin="8,0,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="TestTmdbButton_OnClick"/>
                    <Button x:Name="TestRawgButton" Content="Tester RAWG" Margin="8,0,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="TestRawgButton_OnClick"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#7FB0FF"
                           LineHeight="16" Margin="0,10,0,0" FontSize="12"/>
                <TextBlock x:Name="TmdbStatusText" TextWrapping="Wrap" Foreground="#7FB0FF"
                           LineHeight="16" Margin="0,6,0,0" FontSize="12"/>
                <TextBlock x:Name="RawgStatusText" TextWrapping="Wrap" Foreground="#7FB0FF"
                           LineHeight="16" Margin="0,4,0,0" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
        <!-- WindowStyle="None" means there is no OS title-bar close box; pin one top-right over the
             scrolling content. Uses the x glyph (multiplication sign), which the app font renders. -->
        <Button x:Name="CloseButton" Content="&#215;" ToolTip="Fermer" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,8,12,0" Width="28" Height="28" Padding="0"
                Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF" FontSize="18"
                Cursor="Hand" Click="CloseButton_OnClick"/>
        </Grid>
    </Border>
</Window>