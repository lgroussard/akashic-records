<Window x:Class="AkashicRecords.App.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Settings"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Closing="SettingsView_OnClosing">
    <Border Background="#F21A1A2E" BorderBrush="#553B82F6" BorderThickness="1"
            CornerRadius="8" Padding="0" Width="560" Height="560" Margin="0,0,24,0">
        <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel Margin="24,20">
                <TextBlock Text="PARAMÈTRES" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>

                <TextBlock Text="Modules de cet ordinateur" FontSize="14" FontWeight="SemiBold"
                           Foreground="#7FB0FF" Margin="0,8,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,8"
                           Text="Décochez ce que vous n'utilisez pas ici : la barre du haut, les onglets et la recherche s'adaptent. Rien n'est supprimé, et le téléphone garde ses propres réglages."/>
                <StackPanel x:Name="ModulesPanel" Margin="0,0,0,16"/>

                <TextBlock Text="Synchronisation" FontSize="14" FontWeight="SemiBold"
                           Foreground="#7FB0FF" Margin="0,8,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,8"
                           Text="Relie cet ordinateur au hub de la maison pour que les recettes suivent entre le PC et le téléphone. L'adresse et le code s'obtiennent sur le hub (commande « pair ») ; le code ne sert qu'une fois."/>
                <TextBlock x:Name="SyncStatusText" TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="12"
                           LineHeight="16" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Adresse du hub" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="SyncHubInput" Background="#2A2A45" Foreground="White"
                                 BorderThickness="1" BorderBrush="#553B82F6" Padding="8,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Code d'appairage" Foreground="White" Margin="0,0,0,4"/>
                        <TextBox x:Name="SyncCodeInput" Background="#2A2A45" Foreground="White"
                                 BorderThickness="1" BorderBrush="#553B82F6" Padding="8,6"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                    <Button x:Name="SyncPairButton" Content="Appairer"
                            Style="{StaticResource ChipButtonStyle}" Padding="16,6" Click="SyncPairButton_OnClick"/>
                    <Button x:Name="SyncNowButton" Content="Synchroniser maintenant" Margin="8,0,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="SyncNowButton_OnClick"/>
                    <Button x:Name="SyncUnpairButton" Content="Dissocier" Margin="8,0,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="SyncUnpairButton_OnClick"/>
                </StackPanel>

                <TextBlock Text="Recherche d'images automatiques" FontSize="14" FontWeight="SemiBold"
                           Foreground="#7FB0FF" Margin="0,8,0,12"/>

                <TextBlock TextWrapping="Wrap" Foreground="#CCCCCC" LineHeight="18" Margin="0,0,0,4">
                    <Run FontSize="13">Par défaut, l'ajout d'un élément tente de trouver sa couverture sur</Run>
                    <Run FontSize="13">Wikipédia (aucune clé requise). Jeux vidéo : Steam (aucune clé).</Run>
                    <Run FontSize="13">Pour les affiches de films, animation, séries et anime, entrez une</Run>
                    <Run FontSize="13">clé TMDB gratuite. L'application reste entièrement</Run>
                    <Run FontSize="13">fonctionnelle sans clé — c'est une option.</Run>
                </TextBlock>

                <TextBlock Text="Clé TMDB (affiches de films/animation/anime)" Foreground="White" Margin="0,10,0,4"/>
                <TextBox x:Name="TmdbKeyInput" Background="#2A2A45" Foreground="White"
                         BorderThickness="1" BorderBrush="#553B82F6" Padding="8,6" Margin="0,0,0,4"/>

                <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" LineHeight="16" Margin="0,0,0,4">
                    <Run FontSize="12" FontWeight="SemiBold">TMDB :</Run>
                    <LineBreak/>
                    <Run FontSize="12">Gratuit, sans restriction régionale. Créez une clé sur</Run>
                    <Run FontSize="12">www.themoviedb.org (Compte → Paramètres → Clés API → v3). Indispensable</Run>
                    <Run FontSize="12">pour les affiches de films, animations, séries et anime. Les livres</Run>
                    <Run FontSize="12">utilisent OpenLibrary/Wikipédia, les jeux vidéo Steam et Wikipédia (aucune clé).</Run>
                </TextBlock>

                <TextBlock Text="Clé Pinterest (banque d'images artistiques)" Foreground="White" Margin="0,10,0,4"/>
                <TextBox x:Name="PinterestKeyInput" Background="#2A2A45" Foreground="White"
                         BorderThickness="1" BorderBrush="#553B82F6" Padding="8,6" Margin="0,0,0,4"/>

                <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" LineHeight="16" Margin="0,0,0,4">
                    <Run FontSize="12" FontWeight="SemiBold">Pinterest :</Run>
                    <LineBreak/>
                    <Run FontSize="12">Jeton développeur (developers.pinterest.com, gratuit, niveau</Run>
                    <Run FontSize="12">d'essai = 1000 requêtes/jour). Alimente la banque d'images :</Run>
                    <Run FontSize="12">recherche par titre + les tableaux du compte. Sans jeton,</Run>
                    <Run FontSize="12">Wikipédia sert de repli.</Run>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                    <Button x:Name="SaveButton" Content="Enregistrer"
                            Style="{StaticResource ChipButtonStyle}" Padding="16,6" Click="SaveButton_OnClick"/>
                    <Button x:Name="TestTmdbButton" Content="Tester TMDB" Margin="8,0,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="TestTmdbButton_OnClick"/>
                    <Button x:Name="TestSpotifyButton" Content="Tester les pistes similaires" Margin="8,0,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="TestSpotifyButton_OnClick"/>
                    <Button x:Name="TestPinterestButton" Content="Tester Pinterest" Margin="8,0,0,0"
                            Style="{StaticResource MiniButtonStyle}" Click="TestPinterestButton_OnClick"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#7FB0FF"
                           LineHeight="16" Margin="0,10,0,0" FontSize="12"/>
                <TextBlock x:Name="TmdbStatusText" TextWrapping="Wrap" Foreground="#7FB0FF"
                           LineHeight="16" Margin="0,6,0,0" FontSize="12"/>
                <TextBlock x:Name="SpotifyStatusText" TextWrapping="Wrap" Foreground="#7FB0FF"
                           LineHeight="16" Margin="0,6,0,0" FontSize="12"/>
                <TextBlock x:Name="PinterestStatusText" TextWrapping="Wrap" Foreground="#7FB0FF"
                           LineHeight="16" Margin="0,6,0,0" FontSize="12"/>

                <TextBlock Text="Musique" FontSize="14" FontWeight="SemiBold"
                           Foreground="#7FB0FF" Margin="0,20,0,8"/>
                <CheckBox x:Name="MusicSaveWidgetInput" Foreground="White" FontSize="13"
                          Content="Bouton flottant « Ajouter aux téléchargements »"
                          Checked="MusicSaveWidgetInput_OnChanged" Unchecked="MusicSaveWidgetInput_OnChanged"/>
                <TextBlock TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12" Margin="20,4,0,0"
                           Text="Apparaît tout seul quand un titre similaire hors bibliothèque joue, même lecteur masqué. Un clic l'ajoute à la file du téléchargeur."/>
            </StackPanel>
        </ScrollViewer>
        <!-- WindowStyle="None" means there is no OS title-bar close box; pin one top-right over the
             scrolling content. Uses the x glyph (multiplication sign), which the app font renders. -->
        <Button x:Name="CloseButton" Content="&#215;" ToolTip="Fermer" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,8,12,0" Width="28" Height="28" Padding="0"
                Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF" FontSize="18"
                Cursor="Hand" Click="CloseButton_OnClick"/>
        </Grid>
    </Border>
</Window>