<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scripted smoke test of the hub: starts it on a real local port with a throw-away database
       and plays two simulated devices against it. Exit code 0 = every proof passed.
       No test framework on purpose: nothing to download, runs with `dotnet run`. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AkashicRecords.Hub\AkashicRecords.Hub.csproj" />
    <!-- The real domain class, linked as source: the payload is the app's own Recipe,
         without building (or locking) the Domain project. -->
    <Compile Include="..\AkashicRecords.Domain\Recipe.cs" Link="Domain\Recipe.cs" />
  </ItemGroup>

</Project>
