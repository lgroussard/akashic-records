<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Hub de synchronisation (MOBILITE-SYNC.md). Volontairement autonome :
       aucune reference vers Domain/Infrastructure/App, pour ne rien recompiler de l'app existante. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <!-- One culture only: keeps the published folder small. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No ICU needed: the self-contained Linux build runs on a bare install. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Lets the same exe run as a Windows service (no effect on Linux or in a console). -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Install scripts travel with the published folder (see build-hub.ps1), not with the build. -->
    <Content Remove="deploy\**" />
    <None Include="deploy\**" />
  </ItemGroup>

</Project>
