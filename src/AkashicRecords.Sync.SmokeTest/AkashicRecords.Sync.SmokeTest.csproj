<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scripted test of the sync engine: two local SQLite databases ("pc" and "phone") with the app's
       real Recipe table, kept in step through the real hub hosted in-process. Exit code 0 = all passed.
       With `rehearse <akashic.db>`: runs the engine on a COPY of a real database against a throw-away hub. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\AkashicRecords.Hub\AkashicRecords.Hub.csproj" />
    <ProjectReference Include="..\AkashicRecords.Sync\AkashicRecords.Sync.csproj" />
  </ItemGroup>

</Project>
