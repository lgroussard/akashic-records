<Project Sdk="Microsoft.NET.Sdk">

  <!-- Client side of the sync (MOBILITE-SYNC.md): keeps a local SQLite database in step with the hub.
       Stands alone: no reference to App, Infrastructure or the Hub, so it builds while Akashic runs. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
